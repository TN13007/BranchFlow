@inject IJSRuntime JS
@inject CartDraftStore Drafts
@implements IAsyncDisposable

<section class="order-menu-workspace" @ref="workspace">
    <header class="order-menu-hero">
        <div>
            <h1>Gọi món cho khách</h1>
            <p class="order-menu-branch">@Menu.Branch.Name <span>@Menu.Branch.Code</span></p>
        </div>
        <button class="order-menu-cart-button" type="button" @onclick="OpenCart" disabled="@(Busy || closingDialog)"
                aria-label="Mở giỏ hàng, @Cart.TotalQuantity ly" aria-haspopup="dialog">
            <span aria-hidden="true">🛒</span><span class="order-menu-cart-label">Giỏ hàng</span>
            <span class="order-menu-cart-count" aria-live="polite">@Cart.TotalQuantity</span>
        </button>
    </header>

    <div class="order-menu-messages">
        <ApiError Message="@Error" NeedsLogin="NeedsLogin" Unavailable="Unavailable" OnRetry="OnReload" Busy="Busy" />
        <ApiError Message="@localError" />
        @if (Cart.OutcomeUnknown)
        {
            <div class="alert alert-warning" role="alert">
                <strong>Chưa xác định kết quả tạo đơn.</strong> Giỏ hàng được giữ và không tự gửi lại để tránh trùng đơn.
                <a href="/orders/mine" class="alert-link">Kiểm tra Đơn của tôi</a> trước khi xác nhận lại.
                <div class="form-check mt-2"><input id="checked-orders" class="form-check-input" type="checkbox" @bind="checkedHistory" />
                    <label for="checked-orders" class="form-check-label">Tôi đã kiểm tra và xác nhận đơn này chưa được tạo.</label></div>
                <button class="btn btn-outline-secondary mt-2" type="button" disabled="@(!checkedHistory)" @onclick="Unlock">Cho phép xác nhận lại</button>
                <button class="btn btn-outline-secondary mt-2" type="button" disabled="@Busy" @onclick="() => confirmDiscard = true">Bỏ giỏ sau khi đã đối chiếu</button>
                @if (confirmDiscard)
                {
                    <p class="mt-2 mb-1">Đơn đã lưu vẫn xuất hiện trong Đơn của tôi. Bỏ giỏ hiện tại?</p>
                    <button class="btn btn-outline-danger" type="button" @onclick="DiscardAsync">Xác nhận bỏ giỏ</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => confirmDiscard = false">Giữ giỏ</button>
                }
            </div>
        }
    </div>

    <section class="order-menu-toolbar" aria-label="Tìm kiếm và lọc món">
        <label for="menu-search-input" class="visually-hidden">Tìm món</label>
        <div class="d-flex gap-2">
            <input id="menu-search-input" type="search" class="form-control order-menu-search" placeholder="Tìm món theo tên"
                   @bind="search" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(search) || categoryId != 0)
            {
                <button class="btn btn-outline-secondary text-nowrap" type="button" @onclick="ResetFilter">Bỏ lọc</button>
            }
        </div>
        <nav class="order-menu-categories" aria-label="Danh mục món">
            <button class="order-menu-category @(categoryId == 0 ? "active" : "")" type="button"
                    @onclick="() => categoryId = 0" aria-pressed="@(categoryId == 0)">Tất cả</button>
            @foreach (var category in Menu.Categories)
            {
                <button class="order-menu-category @(categoryId == category.Id ? "active" : "")" type="button"
                        @onclick="() => categoryId = category.Id" aria-pressed="@(categoryId == category.Id)">@category.Name</button>
            }
        </nav>
    </section>

    <section class="order-menu-products" aria-labelledby="product-list-title">
        <div class="order-menu-section-heading"><h2 id="product-list-title">Danh sách món</h2><span>@Products.Count() món</span></div>
        @if (!AllMenuProducts.Any())
        {
            <div class="order-menu-empty" role="status"><span aria-hidden="true">☕</span><strong>Menu đang được cập nhật</strong><p>Chi nhánh hiện chưa có món đang bán.</p></div>
        }
        else if (!Products.Any())
        {
            <div class="order-menu-empty" role="status"><span aria-hidden="true">⌕</span><strong>Không tìm thấy món phù hợp</strong><p>Hãy thử từ khóa hoặc danh mục khác.</p><button class="btn btn-outline-secondary" @onclick="ResetFilter">Xem toàn bộ menu</button></div>
        }
        else
        {
            <div class="order-menu-product-grid">
                @foreach (var product in Products)
                {
                    <article class="order-menu-product-card" @key="product.Id">
                        <div class="order-menu-product-image">
                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="Ảnh @product.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="order-menu-image-placeholder"><span aria-hidden="true">☕</span><small>Chưa có ảnh</small></div>
                            }
                            <span class="order-menu-price-badge">Từ @Money(product.MinPrice)</span>
                        </div>
                        <div class="order-menu-product-body">
                            <div><h3>@product.Name</h3><p>@CategoryName(product.Id) · @product.ProductSizes.Count size</p></div>
                            <button class="btn btn-brand order-menu-select-button" type="button" @onclick="() => Configure(product)"
                                    disabled="@(Busy || closingDialog || Cart.OutcomeUnknown || !CanOrder)" aria-haspopup="dialog">
                                <span>Chọn món</span><span aria-hidden="true">＋</span>
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
    @if (OnReload.HasDelegate)
    {
        <div class="order-menu-refresh"><button class="btn btn-outline-secondary" type="button" @onclick="OnReload" disabled="@Busy">@(Busy ? "Đang tải…" : "Tải lại menu")</button></div>
    }

    @if (showCart)
    {
        <dialog id="order-cart" class="order-dialog order-cart-dialog" aria-labelledby="cart-title">
            <header class="configurator-head"><div><p class="eyebrow">ĐƠN ĐANG TẠO</p><h2 id="cart-title">Giỏ hàng</h2></div>
                <button class="dialog-close" type="button" aria-label="Đóng giỏ hàng" disabled="@Busy" @onclick="CloseCart">×</button>
            </header>
            <div class="order-cart-body">
                <ApiError Message="@Error" NeedsLogin="NeedsLogin" Unavailable="Unavailable" />
                @if (Cart.OutcomeUnknown)
                {
                    <div class="alert alert-warning" role="alert">Chưa xác định kết quả tạo đơn. <a href="/orders/mine" class="alert-link">Kiểm tra Đơn của tôi</a> trước khi gửi lại. Đóng giỏ để xác nhận sau khi đã kiểm tra.</div>
                }
                @if (Cart.Lines.Count == 0)
                {
                    <div class="order-menu-empty" role="status"><span aria-hidden="true">🛒</span><strong>Giỏ hàng chưa có món</strong><p>Chọn một món trong menu để bắt đầu.</p></div>
                }
                @foreach (var line in Cart.Lines)
                {
                    <article class="order-cart-line" @key="line.Key">
                        @if (!string.IsNullOrWhiteSpace(line.ImageUrl)) { <img src="@line.ImageUrl" alt="" /> }
                        <div class="order-cart-description"><h3>@line.ProductName</h3><p>Size @line.SizeName · @line.Request.Quantity ly × @Money(line.PreviewUnitPrice)</p><p>@line.Description</p>
                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => EditFromCart(line)" disabled="@(Busy || closingDialog || Cart.OutcomeUnknown)">Chỉnh sửa tùy chọn</button>
                        </div>
                        <div class="order-cart-line-actions"><strong>@Money(line.PreviewTotal)</strong><button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => Cart.Remove(line.Key)" disabled="@(Busy || closingDialog || Cart.OutcomeUnknown)" aria-label="Xóa @line.ProductName">Xóa</button></div>
                    </article>
                }
            </div>
            <footer class="order-cart-footer">
                <div class="order-cart-total"><div><span>Tổng cộng · @Cart.TotalQuantity ly</span><strong>@Money(Cart.PreviewTotal)</strong></div><small>Giá cuối cùng và mã đơn được máy chủ xác nhận.</small></div>
                @if (Preview) { <p>Bản xem thử không ghi đơn vào cơ sở dữ liệu.</p> }
                <div class="d-flex flex-wrap gap-2 justify-content-end"><button class="btn btn-outline-secondary" type="button" @onclick="CloseCart" disabled="@Busy">Tiếp tục chọn món</button>
                    <button class="btn btn-brand" type="button" disabled="@(Preview || Busy || closingDialog || Cart.Lines.Count == 0 || Cart.OutcomeUnknown || !CanOrder)" @onclick="OnConfirm" aria-busy="@Busy">@(Busy ? "Đang gửi…" : "Xác nhận tạo đơn")</button>
                </div>
            </footer>
        </dialog>
    }
@if (selectedProduct is not null)
{
    <dialog id="product-options" class="order-dialog configurator" aria-labelledby="product-options-title">
        <div class="configurator-head">
            @if (!string.IsNullOrWhiteSpace(selectedProduct.ImageUrl))
            {
                <img class="configurator-image" src="@selectedProduct.ImageUrl" alt="" />
            }
            <div class="configurator-title">
                <p class="eyebrow">TÙY CHỌN MÓN</p>
                <h2 id="product-options-title">@selectedProduct.Name</h2>
                <p>Chọn size bắt buộc, topping và ghi chú trước khi thêm món vào giỏ hàng.</p>
            </div>
            <button class="dialog-close" type="button" aria-label="Đóng tùy chọn món" @onclick="Close">×</button>
        </div>
        <div class="configurator-scroll">
            <ApiError Message="@draftError" />

            <fieldset class="option-block">
                <legend>01 · Chọn size <small>Bắt buộc (chọn 1)</small></legend>
                <div class="option-choices">
                    @foreach (var size in selectedProduct.ProductSizes)
                    {
                        <label class="option-choice">
                            <input type="radio" name="size" value="@size.Id" checked="@(sizeId == size.Id)" @onchange="() => { sizeId = size.Id; draftError = null; }" />
                            <strong>Size @size.SizeName</strong>
                            <span>@Money(size.Price)</span>
                        </label>
                    }
                </div>
            </fieldset>

            <fieldset class="option-block">
                <legend>02 · Topping <small>Mỗi loại tối đa 3 phần/ly, được chọn nhiều loại</small></legend>
                @foreach (var group in Menu.ToppingGroups)
                {
                    @foreach (var topping in group.Toppings)
                    {
                        <div class="topping-row">
                            <div>
                                <strong>@topping.Name</strong>
                                <small>@group.Name · @Money(topping.UnitPrice)/phần (tối đa @Math.Min(3, topping.MaxQuantity))</small>
                            </div>
                            <div class="stepper">
                                <button type="button" @onclick="() => ChangeTopping(topping, -1)" disabled="@(ToppingCount(topping.Id) == 0)" aria-label="Giảm @topping.Name">−</button>
                                <output aria-live="polite">@ToppingCount(topping.Id)</output>
                                <button type="button" @onclick="() => ChangeTopping(topping, 1)" disabled="@(ToppingCount(topping.Id) >= Math.Min(3, topping.MaxQuantity))" aria-label="Thêm @topping.Name">+</button>
                            </div>
                        </div>
                    }
                }
            </fieldset>

            <fieldset class="option-block">
                <legend>03 · Ghi chú nhanh <small>Mỗi nhóm chọn tối đa 1 tùy chọn</small></legend>
                @foreach (var group in Menu.NoteGroups)
                {
                    <div class="note-row">
                        <strong>@group.Name</strong>
                        <div class="option-choices">
                            <label class="option-choice">
                                <input type="radio" name="note-@group.Id" checked="@(!notes.ContainsKey(group.Id))" @onchange="() => notes.Remove(group.Id)" />
                                <span>Mặc định (Không chọn)</span>
                            </label>
                            @foreach (var option in group.Options)
                            {
                                <label class="option-choice">
                                    <input type="radio" name="note-@group.Id" checked="@(notes.GetValueOrDefault(group.Id) == option.Id)" @onchange="() => notes[group.Id] = option.Id" disabled="@(group.MaxSelections < 1)" />
                                    <span>@option.Name</span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </fieldset>

            <div class="option-block">
                <label for="cup-quantity" class="form-label fw-semibold">04 · Số lượng ly <small class="text-secondary fw-normal ms-1">(Số nguyên dương)</small></label>
                <div class="d-flex align-items-center gap-2" style="max-width: 240px;">
                    <button type="button" class="btn btn-outline-secondary" style="width:44px;height:44px;font-weight:600;"
                            @onclick="() => AdjustQuantity(-1)" aria-label="Giảm số ly">−</button>
                    <input id="cup-quantity" type="number" min="1" step="1" class="form-control text-center fw-semibold"
                           style="min-height:44px;" @bind="quantityInput" @bind:event="oninput" />
                    <button type="button" class="btn btn-outline-secondary" style="width:44px;height:44px;font-weight:600;"
                            @onclick="() => AdjustQuantity(1)" aria-label="Tăng số ly">+</button>
                </div>
            </div>
        </div>
        <div class="configurator-action d-flex gap-2">
            <button class="btn btn-outline-secondary" type="button" style="min-height:50px; padding:0 18px; font-weight:600;" @onclick="Close">Hủy</button>
            <button class="btn btn-brand flex-grow-1" type="button" @onclick="Save">
                <span>@(editingKey.HasValue ? "Lưu thay đổi" : "Thêm vào đơn")</span>
                <strong>@Money(DraftTotal())</strong>
            </button>
        </div>
    </dialog>
}
</section>

@code {
    private ElementReference workspace;
    [Parameter, EditorRequired] public OrderMenu Menu { get; set; } = default!;
    [Parameter, EditorRequired] public CartState Cart { get; set; } = default!;
    [Parameter] public bool Preview { get; set; }
    [Parameter] public bool CanOrder { get; set; } = true;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool NeedsLogin { get; set; }
    [Parameter] public bool Unavailable { get; set; }
    [Parameter] public EventCallback OnReload { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    private string search = "";
    private int categoryId;
    private bool showCart;
    private bool openCart;
    private bool checkedHistory;
    private bool confirmDiscard;
    private MenuProduct? selectedProduct;
    private int sizeId;
    private string quantityInput = "1";
    private Guid? editingKey;
    private readonly Dictionary<int, int> toppings = [];
    private readonly Dictionary<int, int> notes = [];
    private string? draftError;
    private string? localError;
    private bool openDialog;
    private IJSObjectReference? module;
    private IEnumerable<MenuProduct> AllMenuProducts => Menu.Categories.SelectMany(c => c.Products);
    private IEnumerable<MenuProduct> Products => Menu.Categories.Where(c => categoryId == 0 || c.Id == categoryId).SelectMany(c => c.Products)
        .Where(p => p.Name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase));
    private string CategoryName(int id) => Menu.Categories.First(c => c.Products.Any(p => p.Id == id)).Name;
    private static string Money(decimal amount) => Display.Money(amount);

    private void ResetFilter()
    {
        search = "";
        categoryId = 0;
    }

    private void AdjustQuantity(int delta)
    {
        var current = long.TryParse(quantityInput.Trim(), out var parsed) ? parsed : 1L;
        var next = Math.Clamp(Math.Clamp(current, 1L, int.MaxValue) + delta, 1L, int.MaxValue);
        quantityInput = next.ToString();
        draftError = null;
    }

    private void Configure(MenuProduct product)
    {
        selectedProduct = product; sizeId = 0; quantityInput = "1"; editingKey = null;
        toppings.Clear(); notes.Clear(); draftError = null; openDialog = true;
    }
    private void Edit(CartLine line)
    {
        var product = Menu.Categories.SelectMany(c => c.Products).FirstOrDefault(p => p.ProductSizes.Any(s => s.Id == line.Request.ProductSizeId));
        if (product is null) { localError = "Món không còn trong menu. Vui lòng xóa dòng và chọn lại."; return; }
        Configure(product); sizeId = line.Request.ProductSizeId; quantityInput = line.Request.Quantity.ToString(); editingKey = line.Key;
        foreach (var t in line.Request.Toppings) toppings[t.ToppingId] = t.Quantity;
        foreach (var id in line.Request.NoteOptionIds)
        {
            var group = Menu.NoteGroups.FirstOrDefault(g => g.Options.Any(o => o.Id == id));
            if (group is not null) notes[group.Id] = id;
        }
    }
    private int ToppingCount(int id) => toppings.GetValueOrDefault(id);
    private void ChangeTopping(MenuTopping t, int delta)
    {
        var count = Math.Clamp(ToppingCount(t.Id) + delta, 0, Math.Min(3, t.MaxQuantity));
        if (count == 0) toppings.Remove(t.Id); else toppings[t.Id] = count;
    }
    private CreateOrderItem Draft() => new(sizeId, int.TryParse(quantityInput, out var cups) ? cups : 0, toppings.Select(t => new CreateOrderTopping(t.Key, t.Value)).ToList(), notes.Values.ToList());
    private decimal DraftTotal()
    {
        try { return CartState.BuildLine(Menu, Draft(), Guid.Empty).PreviewTotal; }
        catch (Exception ex) when (ex is InvalidOperationException or OverflowException) { return 0; }
    }
    private async Task Save()
    {
        if (closingDialog) return;
        try
        {
            var returnToCart = editingKey.HasValue;
            Cart.Save(Menu, Draft(), editingKey);
            localError = null;
            await Close();
            if (returnToCart) OpenCart();
        }
        catch (Exception ex) when (ex is InvalidOperationException or OverflowException) { draftError = ex is OverflowException ? "Số lượng vượt giới hạn." : ex.Message; }
    }
    private bool closingDialog;
    private async Task Close()
    {
        if (closingDialog) return;
        closingDialog = true;
        try
        {
            if (module is not null) await module.InvokeVoidAsync("closeDialog", workspace, "product-options");
            selectedProduct = null;
        }
        finally { closingDialog = false; }
    }
    private void Unlock() { Cart.AcknowledgeCheckedHistory(); checkedHistory = false; confirmDiscard = false; }
    private async Task DiscardAsync()
    {
        Cart.Clear();
        checkedHistory = false;
        confirmDiscard = false;
        await Drafts.SaveAsync(Cart);
    }
    // Mở giỏ bằng dialog để giữ focus và giao diện menu phía sau.
    private void OpenCart() { showCart = true; openCart = true; }
    private async Task CloseCart()
    {
        if (Busy) return;
        if (module is not null) await module.InvokeVoidAsync("closeDialog", workspace, "order-cart");
        showCart = false;
    }
    // Đóng giỏ trước khi mở tùy chọn, tránh hai dialog chồng nhau.
    private async Task EditFromCart(CartLine line)
    {
        await CloseCart();
        Edit(line);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Drafts.SaveAsync(Cart);
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/order-dialogs.js");
        if (openCart && showCart)
        {
            openCart = false;
            await module.InvokeVoidAsync("openDialog", workspace, "order-cart");
        }
        if (openDialog && selectedProduct is not null)
        {
            openDialog = false;
            await module.InvokeVoidAsync("openDialog", workspace, "product-options");
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (module is not null) try
        {
            await module.InvokeVoidAsync("disposeDialogs", workspace);
            await module.DisposeAsync();
        } catch (Exception ex) when (ex is JSDisconnectedException or OperationCanceledException) { }
    }
}

@if (Message is not null)
{
    <div class="alert alert-danger" role="alert">
        @Message
        @if (NeedsLogin) { <a href="/login" class="alert-link ms-2" data-enhance-nav="false">Đăng nhập lại</a> }
    </div>
}
@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool NeedsLogin { get; set; }
}

<nav class="preview-role-switcher" aria-label="Chuyển giao diện xem thử theo vai trò">
    <a href="/preview/employee" class="btn btn-sm btn-outline-dark preview-role-link"
       aria-current="@(CurrentRole == "employee" ? "true" : null)">Nhân viên</a>
    <a href="/preview/admin" class="btn btn-sm btn-outline-dark preview-role-link"
       aria-current="@(CurrentRole == "admin" ? "true" : null)">Quản trị</a>
    <a href="/preview/owner" class="btn btn-sm btn-outline-dark preview-role-link"
       aria-current="@(CurrentRole == "owner" ? "true" : null)">Chủ sở hữu</a>
</nav>

@code {
    [Parameter, EditorRequired] public string CurrentRole { get; set; } = "employee";
}

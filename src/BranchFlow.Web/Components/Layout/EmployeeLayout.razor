@inherits LayoutComponentBase
@using BranchFlow.Web.Models.Appearance
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Authentication

<div class="employee-shell @(isOrdering ? "scene-drink-counter ordering-shell" : "business-shell")">
    <a class="skip-link" href="#main-content">Đến nội dung</a>
    <aside class="employee-sidebar" data-companion="@companionKey">
        <a href="@WorkspaceNavigation.Home(role)" class="employee-brand">
            <span class="employee-mark-wrap" aria-hidden="true"><span class="employee-mark">BF</span><img class="employee-hat" src="/images/christmas/decorations/bf-santa-hat.svg" alt="" /></span>
            <span><strong>BranchFlow</strong><small>@WorkspaceNavigation.RoleLabel(role)</small></span>
        </a>
        <nav aria-label="Menu @WorkspaceNavigation.RoleLabel(role)">
            @foreach (var link in links)
            {
                <a href="@link.Url" class="@(IsCurrent(link) ? "active" : "")" aria-current="@(IsCurrent(link) ? "page" : null)">
                    <img src="@link.Icon" alt="" aria-hidden="true" /><span>@link.Label</span>
                </a>
            }
        </nav>
        <SidebarCompanion OnStyleChanged="key => companionKey = key" />
        <div class="employee-user">
            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="user-badge"><span class="user-status-dot" aria-hidden="true"></span><span>@auth.User.Identity?.Name</span></div>
                    <form action="/auth/logout" method="post" data-enhance="false"><AntiforgeryToken /><button type="submit" class="logout-button">Đăng xuất</button></form>
                </Authorized>
                <NotAuthorized><a href="/login" class="login-sidebar-link">Đăng nhập</a></NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>
    <div class="workspace-body">
        <header class="mobile-workspace-header" @onkeydown="CloseOnEscape">
            <a href="@WorkspaceNavigation.Home(role)" class="mobile-brand"><span>BF</span><strong>BranchFlow</strong></a>
            <span class="mobile-role">@WorkspaceNavigation.RoleLabel(role)</span>
            <details class="mobile-all-menu" open="@menuOpen">
                <summary @onclick="() => menuOpen = !menuOpen" @onclick:preventDefault aria-label="Mở menu chức năng" aria-expanded="@menuOpen">Menu</summary>
                <nav aria-label="Tất cả chức năng">
                    @foreach (var link in links)
                    {
                        <a href="@link.Url" aria-current="@(IsCurrent(link) ? "page" : null)"><img src="@link.Icon" alt="" />@link.Label</a>
                    }
                </nav>
            </details>
        </header>
        <main id="main-content" class="employee-main">@Body</main>
    </div>
    <nav class="mobile-bottom-nav" aria-label="Điều hướng chính">
        @foreach (var link in links.Where(item => item.Mobile))
        {
            <a href="@link.Url" class="@(IsMobileCurrent(link) ? "active" : "")" aria-current="@(IsMobileCurrent(link) ? "page" : null)"><img src="@link.Icon" alt="" /><span>@link.Label</span></a>
        }
    </nav>
</div>

@code {
    private string companionKey = "ginger";
    private string role = "";
    private string relativePath = "";
    private string? currentTab;
    private bool menuOpen;
    private bool isOrdering => relativePath.Split('?')[0].Equals("orders/create", StringComparison.OrdinalIgnoreCase);
    private IReadOnlyList<WorkspaceLink> links => WorkspaceNavigation.Links(role);
    private bool IsCurrent(WorkspaceLink link) => WorkspaceNavigation.IsCurrent(link, relativePath, currentTab);
    private bool IsMobileCurrent(WorkspaceLink link) => IsCurrent(link) ||
        (role == "EMPLOYEE" && link.Key == "stock" && currentTab is "issue" or "stocktake") ||
        (role == "SYSTEM_ADMIN" && link.Key == "inventory" && currentTab == "transfer");
    protected override async Task OnInitializedAsync()
    {
        role = WorkspaceNavigation.Role((await Authentication.GetAuthenticationStateAsync()).User);
        UpdateLocation();
        Navigation.LocationChanged += OnLocationChanged;
        Authentication.AuthenticationStateChanged += OnAuthenticationChanged;
    }
    private async void OnAuthenticationChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        await InvokeAsync(() => { role = WorkspaceNavigation.Role(state.User); StateHasChanged(); });
    }
    private void UpdateLocation()
    {
        relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        currentTab = query.TryGetValue("tab", out var tab) ? tab.ToString() : null;
        menuOpen = false;
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) { UpdateLocation(); _ = InvokeAsync(StateHasChanged); }
    private void CloseOnEscape(KeyboardEventArgs e) { if (e.Key == "Escape") menuOpen = false; }
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Authentication.AuthenticationStateChanged -= OnAuthenticationChanged;
    }
}

@inject IJSRuntime JS
@using BranchFlow.Web.Models.Inventory
@implements IAsyncDisposable

<div class="warehouse-preview" @ref="root">
    <header class="page-heading birch-heading warehouse-heading">
        <div>
            <p class="eyebrow">XƯỞNG QUÀ MÙA ĐÔNG · GÓC NHÂN VIÊN</p>
            <h1>Tồn kho nguyên liệu</h1>
            <p>Vuốt hoặc kéo ngang để xem kho kế tiếp. Số lượng là dữ liệu minh họa.</p>
        </div>
        <div class="warehouse-switcher" role="group" aria-label="Chọn kho nguyên liệu">
            <button type="button" class="warehouse-arrow" aria-label="Kho trước" aria-controls="warehouse-viewport"
                    disabled="@(activeIndex == 0 || module is null)" @onclick="() => StepAsync(-1)">←</button>
            <span class="warehouse-counter" role="status" aria-live="polite" aria-atomic="true">@CurrentWarehouseName <small>/ @Warehouses.Count.ToString("00")</small></span>
            <button type="button" class="warehouse-arrow" aria-label="Kho tiếp theo" aria-controls="warehouse-viewport"
                    disabled="@(Warehouses.Count < 2 || activeIndex == Warehouses.Count - 1 || module is null)" @onclick="() => StepAsync(1)">→</button>
        </div>
    </header>

    <div class="warehouse-content">
        <p id="warehouse-help" class="warehouse-help">@Warehouses.Count kho minh họa · Dùng mũi tên, vuốt ngang hoặc phím ← → khi chọn vùng kệ.</p>
        <div id="warehouse-viewport" class="warehouse-viewport" role="region" aria-roledescription="băng chuyền"
             aria-label="Các kho nguyên liệu" aria-describedby="warehouse-help" tabindex="0">
            @for (var i = 0; i < Warehouses.Count; i++)
            {
                var index = i;
                var warehouse = Warehouses[index];
                <section class="warehouse-slide" @key="warehouse.Id" data-warehouse="@index" data-warehouse-id="@warehouse.Id" role="group" aria-roledescription="trang kho"
                         aria-label="@warehouse.Name trong @Warehouses.Count kho" aria-hidden="@(index == activeIndex ? "false" : "true")" inert="@(index != activeIndex)">
                    <div class="warehouse-cabinet">
                        <span class="warehouse-room-number" aria-hidden="true">@warehouse.Name</span>
                        @if (warehouse.Items.Count > 0)
                        {
                            <ul class="warehouse-shelf-products">
                                @foreach (var product in warehouse.Items)
                                {
                                    <li class="warehouse-product" @key="product.Id" data-ingredient-id="@product.Id">
                                        <img src="@product.ImageUrl" alt="" aria-hidden="true" draggable="false" width="200" height="240" />
                                        <div class="warehouse-product-tag" title="@product.Name · @product.QuantityText · @product.StatusLabel">
                                            <h2>@product.Name</h2>
                                            <p><span>Tồn: @product.QuantityText</span><span class="warehouse-product-status @(product.Availability != StockAvailability.Available ? "needs-review" : "")" aria-label="@product.StatusLabel">@product.StatusSymbol</span></p>
                                            <span class="visually-hidden">@product.Code · @product.StatusLabel</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="warehouse-empty"><h2>@warehouse.Name chưa có dữ liệu</h2><p>Chưa có nguyên liệu mẫu trong kho này.</p></div>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WarehouseStock> Warehouses { get; set; } = [];
    private ElementReference root;
    private IJSObjectReference? module;
    private DotNetObjectReference<WarehouseStockPreview>? reference;
    private int activeIndex;
    private bool disposed;
    private int renderedCount = -1;
    private bool syncCount;
    private string CurrentWarehouseName => Warehouses.Count == 0 ? "Chưa có kho" : Warehouses[activeIndex].Name;

    protected override void OnParametersSet()
    {
        activeIndex = Math.Clamp(activeIndex, 0, Math.Max(0, Warehouses.Count - 1));
        syncCount = renderedCount != Warehouses.Count;
        renderedCount = Warehouses.Count;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (syncCount && module is not null && !disposed)
            {
                syncCount = false;
                await module.InvokeVoidAsync("refresh", root);
            }
            return;
        }
        module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/warehouse-stock.js");
        if (disposed) { await module.DisposeAsync(); return; }
        reference = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("init", root, reference);
        syncCount = false;
        if (!disposed) StateHasChanged();
    }

    private async Task StepAsync(int direction)
    {
        if (module is not null && !disposed) await module.InvokeVoidAsync("step", root, direction);
    }

    [JSInvokable]
    public Task OnWarehouseChanged(int index)
    {
        if (disposed || index < 0 || index >= Warehouses.Count || index == activeIndex) return Task.CompletedTask;
        return InvokeAsync(() => { activeIndex = index; StateHasChanged(); });
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is not null)
            try { await module.InvokeVoidAsync("dispose", root); await module.DisposeAsync(); }
            catch (Exception ex) when (ex is JSDisconnectedException or OperationCanceledException) { }
        reference?.Dispose();
    }
}

@inject ManagementApiClient Api
@using System.Globalization

<div class="surface-card management-panel">
    <ApiError Message="@(selectedOrderId is null ? error : null)" NeedsLogin="@needsLogin" OnRetry="ReloadAsync" Busy="busy" />
    @if (notice is not null) { <p class="alert alert-success" role="status">@notice</p> }
    <fieldset disabled="@(busy || selectedOrderId is null && (needsLogin || accessDenied))">
    @if (NeedsBranch && selectedOrderId is null)
    {
        <div class="management-filters">
            <label class="management-field">Chi nhánh
                <select class="form-select" value="@branchId" @onchange="ChangeBranchAsync">
                    @if (CanReadAll) { <option value="0">Tất cả chi nhánh</option> }
                    else { <option value="0">Chọn chi nhánh</option> }
                    @foreach (var b in branches.Where(b => b.IsActive)) { <option value="@b.Id">@b.Name</option> }
                </select>
            </label>
            @if (UsesDateFilter)
            {
                <label class="management-field management-date">Từ ngày <input class="form-control" type="date" @bind="from" /></label>
                <label class="management-field management-date">Đến ngày <input class="form-control" type="date" @bind="to" /></label>
                <button class="btn btn-brand" type="button" @onclick="ReloadAsync">Áp dụng bộ lọc</button>
                <div class="management-presets" aria-label="Khoảng thời gian nhanh">
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => SetRangeAsync(1)">Hôm nay</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => SetRangeAsync(7)">7 ngày qua</button>
                </div>
            }
        </div>
    }
    @switch (Tab)
    {
        case "branches":
            <div class="management-toolbar">
                <label class="management-field">Tìm chi nhánh <input class="form-control" type="search" placeholder="Tên hoặc mã chi nhánh" @bind="search" @bind:event="oninput" /></label>
                @if (IsSystem)
                { <button class="btn btn-brand" type="button" @onclick="() => EditBranch(new())">Thêm chi nhánh</button> }
            </div>
            @if (IsSystem && editingBranch)
            {
                <section class="management-editor">
                    <h2 class="h5" tabindex="-1" @ref="editorHeading">@(branch.Id == 0 ? "Thêm chi nhánh" : "Sửa chi nhánh")</h2>
                    <p class="text-secondary">Nhập mã, tên và địa chỉ để lưu chi nhánh.</p>
                    <div class="management-form-grid">
                    <label class="management-field">Mã chi nhánh <input class="form-control w-auto" aria-label="Mã chi nhánh" placeholder="Mã chi nhánh" @bind="branch.Code" disabled="@(branch.Id > 0)" /></label>
                    <label class="management-field">Tên chi nhánh <input class="form-control w-auto" aria-label="Tên chi nhánh" placeholder="Tên chi nhánh" @bind="branch.Name" /></label>
                    <label class="management-field">Địa chỉ <input class="form-control w-auto" aria-label="Địa chỉ" placeholder="Địa chỉ" @bind="branch.Address" /></label>
                    <label><input type="checkbox" @bind="branch.IsActive" /> Hoạt động</label>
                    </div>
                    <div class="management-actions">
                        <button class="btn btn-brand" @onclick='() => SaveAsync("branches", branch.Id, branch, () => editingBranch = false)'>Lưu chi nhánh</button>
                        <button class="btn btn-outline-secondary" @onclick="() => editingBranch = false">Đóng</button>
                    </div>
                </section>
            }
            <div class="table-responsive"><table class="table management-table" role="table"><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Mã</th><th scope="col" role="columnheader">Tên</th><th scope="col" role="columnheader">Địa chỉ</th><th scope="col" role="columnheader">Quản lý</th><th scope="col" role="columnheader">Trạng thái</th><th scope="col" role="columnheader"></th></tr></thead><tbody role="rowgroup">
            @foreach (var b in FilteredBranches)
            {
                <tr role="row"><td role="cell" data-label="Mã">@b.Code</td><td role="cell" data-label="Tên chi nhánh">@b.Name</td><td role="cell" data-label="Địa chỉ">@b.Address</td><td role="cell" data-label="Quản lý">@b.AdminName</td><td role="cell" data-label="Trạng thái">@(b.IsActive ? "Hoạt động" : "Đã tắt")</td>
                    <td role="cell" data-label="">@if (IsSystem) { <button class="btn btn-outline-secondary" @onclick="() => EditBranch(Copy(b))">Sửa</button> }</td></tr>
            }
            </tbody></table></div>
            @if (loaded && !FilteredBranches.Any()) { <p class="management-empty" role="status">Không tìm thấy chi nhánh phù hợp.</p> }
            break;
        case "employee-directory":
            <div class="management-toolbar">
                <label class="management-field">Tìm nhân viên <input class="form-control" type="search" placeholder="Tên, mã hoặc chức vụ" @bind="search" @bind:event="oninput" /></label>
            </div>
            <div class="table-responsive">
                <table class="table management-table" role="table">
                    <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Mã nhân viên</th><th scope="col" role="columnheader">Họ tên</th><th scope="col" role="columnheader">Chức vụ</th><th scope="col" role="columnheader">Chi nhánh</th><th scope="col" role="columnheader">Trạng thái</th></tr></thead>
                    <tbody role="rowgroup">
                        @foreach (var employee in FilteredDirectory)
                        {
                            <tr role="row"><td role="cell" data-label="Mã nhân viên">@(string.IsNullOrEmpty(employee.EmployeeCode) ? "—" : employee.EmployeeCode)</td><td role="cell" data-label="Họ tên">@employee.FullName</td><td role="cell" data-label="Chức vụ">@(employee.Position ?? "—")</td>
                                <td role="cell" data-label="Chi nhánh">@employee.BranchName</td><td role="cell" data-label="Trạng thái">@(employee.IsActive ? "Hoạt động" : "Đã khóa")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (loaded && !busy && !FilteredDirectory.Any())
            {
                <p class="management-empty" role="status">Không tìm thấy nhân viên phù hợp.</p>
            }
            break;
        case "employees":
            <div class="management-toolbar">
                <label class="management-field">Tìm tài khoản <input class="form-control" type="search" placeholder="Tên, tài khoản hoặc chi nhánh" @bind="search" @bind:event="oninput" /></label>
                @if (IsSystem)
                {
                    <div class="management-actions">
                        <button class="btn btn-brand" type="button" @onclick='() => OpenUserEditor("create")'>Tạo tài khoản</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick='() => OpenUserEditor("assign")'>Phân công chi nhánh</button>
                    </div>
                }
            </div>
            @if (IsSystem && userEditor == "create")
            {
                <section class="management-editor">
                    <h2 class="h5" tabindex="-1" @ref="editorHeading">Tạo tài khoản</h2>
                    <div class="management-form-grid">
                    <label class="management-field">Tên đăng nhập <input class="form-control w-auto" aria-label="Tên đăng nhập" placeholder="Tên đăng nhập" @bind="newUser.Username" /></label>
                    <label class="management-field">Họ tên <input class="form-control w-auto" aria-label="Họ tên tài khoản mới" placeholder="Họ tên" @bind="newUser.FullName" /></label>
                    <label class="management-field">Mật khẩu ban đầu <input class="form-control w-auto" type="password" autocomplete="new-password" aria-label="Mật khẩu ban đầu" placeholder="Mật khẩu ban đầu" @bind="newUser.Password" /></label>
                    <label class="management-field">Vai trò <select class="form-select w-auto" aria-label="Vai trò" @bind="newUser.Role"><option value="EMPLOYEE">Nhân viên</option><option value="BRANCH_ADMIN">Admin Chi nhánh</option></select></label>
                    <label class="management-field">Chi nhánh ban đầu <select class="form-select w-auto" aria-label="Chi nhánh ban đầu" @bind="newUser.BranchId"><option value="">Chưa phân công</option>@foreach (var b in branches.Where(b => b.IsActive)) { <option value="@b.Id">@b.Name</option> }</select></label>
                    </div>
                    <div class="management-actions">
                        <button class="btn btn-brand" @onclick='() => SaveAsync("users", 0, newUser, FinishUserCreation)'>Lưu tài khoản</button>
                        <button class="btn btn-outline-secondary" @onclick="CloseUserEditor">Đóng</button>
                    </div>
                </section>
            }
            @if (IsSystem && userEditor == "assign")
            {
                <section class="management-editor">
                    <h2 class="h5" tabindex="-1" @ref="editorHeading">Phân công chi nhánh</h2>
                    <div class="management-form-grid">
                    <label class="management-field">Tài khoản <select class="form-select w-auto" aria-label="Tài khoản phân công" @bind="assignment.UserId"><option value="0">Chọn tài khoản</option>@foreach (var u in users.Where(u => u.IsActive && u.Role is "EMPLOYEE" or "BRANCH_ADMIN")) { <option value="@u.Id">@u.FullName · @u.Username</option> }</select></label>
                    <label class="management-field">Chi nhánh <select class="form-select w-auto" aria-label="Chi nhánh phân công" @bind="assignment.BranchId"><option value="0">Chọn chi nhánh</option>@foreach (var b in branches.Where(b => b.IsActive)) { <option value="@b.Id">@b.Name</option> }</select></label>
                    </div>
                    <div class="management-actions">
                        <button class="btn btn-brand" @onclick='() => SaveAsync("assignments", 0, assignment, FinishAssignment)'>Lưu phân công</button>
                        <button class="btn btn-outline-secondary" @onclick="CloseUserEditor">Đóng</button>
                    </div>
                </section>
            }
            @if (user is not null && CanEditUsers)
            {
                <section class="management-editor">
                    <h2 class="h5" tabindex="-1" @ref="editorHeading">Hồ sơ @user.Username</h2>
                    <div class="management-form-grid">
                    <label class="management-field">Họ tên <input class="form-control w-auto" aria-label="Họ tên" @bind="user.FullName" /></label>
                    <label class="management-field">Email <input class="form-control w-auto" aria-label="Email" placeholder="Email" @bind="user.Email" /></label>
                    <label class="management-field">Điện thoại <input class="form-control w-auto" aria-label="Điện thoại" placeholder="Điện thoại" @bind="user.Phone" /></label>
                    @if (user.Role == "EMPLOYEE") { <label class="management-field">Vị trí <input class="form-control w-auto" aria-label="Vị trí" placeholder="Vị trí" @bind="user.Position" /></label> }
                    @if (IsSystem)
                    {
                        <label><input type="checkbox" @bind="user.IsActive" /> Hoạt động</label>
                        @if (user.BranchId.HasValue)
                        {
                            <label><input type="checkbox" @bind="user.CanReceive" /> Nhập kho</label>
                            <label><input type="checkbox" @bind="user.CanIssue" /> Xuất kho</label>
                        }
                    }
                    </div>
                    <div class="management-actions">
                        <button class="btn btn-brand" @onclick='() => SaveAsync("users", user.Id, user, CloseUserEditor)'>Lưu hồ sơ</button>
                        <button class="btn btn-outline-secondary" @onclick="CloseUserEditor">Đóng</button>
                    </div>
                </section>
            }
            <div class="table-responsive"><table class="table management-table" role="table"><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Tài khoản</th><th scope="col" role="columnheader">Họ tên</th><th scope="col" role="columnheader">Vai trò</th><th scope="col" role="columnheader">Chi nhánh nhân viên</th><th scope="col" role="columnheader">Trạng thái</th><th scope="col" role="columnheader"></th></tr></thead><tbody role="rowgroup">
            @foreach (var u in FilteredUsers)
            {
                <tr role="row"><td role="cell" data-label="Tài khoản">@u.Username</td><td role="cell" data-label="Họ tên">@u.FullName</td><td role="cell" data-label="Vai trò">@BranchFlow.Web.Models.Appearance.WorkspaceNavigation.RoleLabel(u.Role)</td><td role="cell" data-label="Chi nhánh">@u.BranchName</td><td role="cell" data-label="Trạng thái">@(u.IsActive ? "Hoạt động" : "Đã khóa")</td>
                    <td role="cell" data-label="">@if (CanEditUser(u)) { <button class="btn btn-outline-secondary" @onclick="() => EditUser(u)">Sửa hồ sơ</button> }</td></tr>
            }
            </tbody></table></div>
            @if (loaded && !FilteredUsers.Any()) { <p class="management-empty" role="status">Không tìm thấy tài khoản phù hợp.</p> }
            break;
        case "system-menu":
        case "branch-menu":
            <ManagementMenu @key="(Tab, branchId)" SystemMenu="@(Tab == "system-menu")" BranchId="@branchId" />
            break;
        case "stock":
        case "inventory":
        case "issue":
            <ManagementStock @key="(Tab, branchId)" BranchId="@branchId" Role="@Role" IssueFirst="@(Tab == "issue")" />
            break;
        case "orders":
            @if (selectedOrderId is int detailId)
            {
                <section aria-labelledby="managed-order-detail">
                <div class="management-toolbar management-order-heading">
                    <h2 class="h5 mb-0" id="managed-order-detail" tabindex="-1" @ref="orderHeading">Chi tiết đơn @(order?.Code)</h2>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseOrder">← Về danh sách đơn</button>
                </div>
                <ApiError Message="@error" NeedsLogin="@needsLogin" OnRetry="() => OpenOrderAsync(detailId)" Busy="busy" />
            @if (order is not null)
            {
                <div class="management-order-summary">
                    <div><span>Chi nhánh</span><strong>@order.BranchName</strong></div>
                    <div><span>Thời gian</span><strong>@VietnamTime(order.CreatedAt) (giờ VN)</strong></div>
                    <div><span>Tổng đã lưu</span><strong>@Money(order.TotalAmount)</strong></div>
                    <div><span>Trạng thái</span><StatusBadge Status="@order.Status" /></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(order.ReportReason))
                {
                    <div class="management-order-report">
                        <strong>@(order.HasPendingReport ? "Nhân viên báo sai · Chờ xử lý" : "Báo cáo của nhân viên")</strong>
                        <p>@order.ReportReason</p>
                        @if (order.ReportedAt is { } reportedAt) { <small>Ngày gửi @VietnamTime(reportedAt) (giờ VN)</small> }
                    </div>
                }
                <div class="table-responsive"><table class="table management-table" role="table"><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Món</th><th scope="col" role="columnheader">Size / Tùy chọn</th><th scope="col" role="columnheader">Giá đã chốt mỗi ly</th><th scope="col" role="columnheader">Số ly</th><th scope="col" role="columnheader">Thành tiền đã lưu</th></tr></thead><tbody role="rowgroup">
                @foreach (var line in order.Items)
                {
                    <tr role="row"><td role="cell" data-label="Món">@line.Name</td><td role="cell" data-label="Size và tùy chọn">@line.Size · @line.Options</td><td role="cell" data-label="Đơn giá">@Money(line.UnitAmount)</td>
                        <td role="cell" data-label="Số ly">@if (CanAdjust) { <input class="form-control" type="number" min="1" max="999" aria-label="Số ly @line.Name" @bind="line.Quantity" /> } else { @line.Quantity }</td><td role="cell" data-label="Thành tiền">@Money(line.Subtotal)</td></tr>
                }
                </tbody></table></div>
                @if (CanAdjust)
                {
                    <section class="management-editor mt-3">
                    <p>Tổng sau khi sửa số ly <strong>@Money(order.Items.Sum(x => x.UnitAmount * x.Quantity))</strong></p>
                    <label class="management-field">Lý do sửa hoặc hủy<input class="form-control" maxlength="500" placeholder="Ví dụ: khách yêu cầu đổi số ly" @bind="reason" /></label>
                    <div class="management-actions">
                        <button class="btn btn-brand" @onclick="() => AdjustAsync(false)">Lưu số ly</button>
                        @if (confirmCancel)
                        {
                            <button class="btn btn-danger" @onclick="() => AdjustAsync(true)">Xác nhận hủy đơn @order.Code</button>
                            <button class="btn btn-outline-secondary" @onclick="() => confirmCancel = false">Giữ đơn</button>
                        }
                        else { <button class="btn btn-outline-danger" @onclick="() => confirmCancel = true">Hủy đơn</button> }
                    </div>
                    </section>
                }
                @if (order.History.Count > 0)
                {
                    <h3 class="h6">Lịch sử chỉnh sửa</h3>
                    @foreach (var change in order.History)
                    {
                        <details class="management-record"><summary>@VietnamTime(change.CreatedAt) · @change.PerformedBy · @change.Reason</summary>
                            <p>Trước: @DescribeAdjustment(change.BeforeData)</p><p>Sau: @DescribeAdjustment(change.AfterData)</p>
                        </details>
                    }
                }
            }
                </section>
            }
            else
            {
            @if (CanEditUsers && reportedOrders.Count > 0)
            {
                <section class="management-order-report mb-3" aria-labelledby="reported-orders-heading">
                    <h2 id="reported-orders-heading">Đơn nhân viên báo sai</h2>
                    <ul class="management-report-list">
                        @foreach (var report in reportedOrders.Take(showAllReports ? 50 : 4))
                        {
                            <li @key="report.Id">
                                <div><strong>@report.Code</strong><small>@report.BranchName · @report.EmployeeName</small><p>@report.ReportReason</p></div>
                                <button class="btn btn-outline-secondary" type="button" aria-label="Xử lý báo cáo đơn @report.Code"
                                        @onclick="() => OpenOrderAsync(report.Id)">Xử lý báo cáo</button>
                            </li>
                        }
                    </ul>
                    @if (reportedOrders.Count > 4)
                    { <button class="btn btn-outline-secondary" type="button" @onclick="() => showAllReports = !showAllReports">@(showAllReports ? "Thu gọn" : $"Xem thêm ({reportedOrders.Count - 4})")</button> }
                </section>
            }
            <h2 class="h5" tabindex="-1" @ref="orderHeading">Danh sách đơn hàng</h2>
            <div class="management-toolbar">
                <label class="management-field">Tìm đơn <input class="form-control" type="search" placeholder="Mã đơn hoặc tên nhân viên" @bind="search" @bind:event="oninput" /></label>
                <label class="management-field">Trạng thái
                    <select class="form-select" @bind="orderStatus">
                        <option value="">Tất cả trạng thái</option>
                        <option value="COMPLETED">Hoàn tất</option><option value="CANCELLED">Đã hủy</option><option value="NEEDS_REVIEW">Cần xem lại</option>
                    </select>
                </label>
            </div>
            <div class="table-responsive"><table class="table management-table" role="table"><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Mã đơn</th><th scope="col" role="columnheader">Chi nhánh</th><th scope="col" role="columnheader">Nhân viên</th><th scope="col" role="columnheader">Thời gian (VN)</th><th scope="col" role="columnheader">Tổng tiền</th><th scope="col" role="columnheader">Trạng thái</th></tr></thead><tbody role="rowgroup">
            @foreach (var o in FilteredOrders)
            {
                <tr role="row"><td role="cell" data-label="Mã đơn"><strong class="d-block">@o.Code</strong>
                        <button class="btn btn-sm btn-outline-secondary mt-1 text-nowrap" type="button" aria-label="Xem chi tiết đơn @o.Code"
                                @onclick="() => OpenOrderAsync(o.Id)">Xem chi tiết</button></td>
                    <td role="cell" data-label="Chi nhánh">@o.BranchName</td><td role="cell" data-label="Nhân viên">@o.EmployeeName</td><td role="cell" data-label="Thời gian">@VietnamTime(o.CreatedAt)</td>
                    <td role="cell" data-label="Tổng tiền">@Money(o.TotalAmount)</td><td role="cell" data-label="Trạng thái"><StatusBadge Status="@o.Status" /></td></tr>
            }
            </tbody></table></div>
            @if (loaded && !busy && !FilteredOrders.Any()) { <p class="management-empty" role="status">Không tìm thấy đơn. Thử đổi bộ lọc hoặc mở rộng khoảng ngày.</p> }
            @if (orders.Count == 200) { <p>Hiển thị 200 đơn mới nhất. Thu hẹp khoảng ngày để tra cứu.</p> }
            }
            break;
        case "overview":
        case "analytics":
            <h2 class="h5">Doanh thu theo ngày và chi nhánh</h2>
            @if (loaded && error is null)
            {
            var total = revenue.Sum(x => x.Amount);
            var count = revenue.Sum(x => x.Orders);
            <div class="management-metrics">
                <article><span>Doanh thu</span><strong>@Money(total)</strong><small>Đơn hoàn tất trong khoảng đã chọn</small></article>
                <article><span>Đơn hoàn tất</span><strong>@count.ToString("N0")</strong><small>Đơn hủy không tính vào tổng</small></article>
                <article><span>Trung bình mỗi đơn</span><strong>@Money(count == 0 ? 0 : total / count)</strong><small>Doanh thu chia số đơn hoàn tất</small></article>
            </div>
            <div class="table-responsive"><table class="table management-table" role="table"><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Ngày (VN)</th><th scope="col" role="columnheader">Chi nhánh</th><th scope="col" role="columnheader">Số đơn</th><th scope="col" role="columnheader">Doanh thu</th></tr></thead><tbody role="rowgroup">
                @foreach (var r in revenue) { <tr role="row"><td role="cell" data-label="Ngày">@r.Date.ToString("dd/MM/yyyy")</td><td role="cell" data-label="Chi nhánh">@r.BranchName</td><td role="cell" data-label="Số đơn">@r.Orders</td><td role="cell" data-label="Doanh thu">@Money(r.Amount)</td></tr> }
            </tbody></table></div>
            @if (loaded && !busy && revenue.Count == 0) { <p class="management-empty" role="status">Không có đơn hoàn thành trong khoảng ngày đã chọn. Bạn có thể thử 7 ngày qua.</p> }
            }
            break;
    }
    </fieldset>
    @if (busy) { <p role="status">Đang xử lý…</p> }
</div>

@code {
    [Parameter, EditorRequired] public string Tab { get; set; } = "";
    [Parameter, EditorRequired] public string Role { get; set; } = "";
    private bool IsSystem => Role == "SYSTEM_ADMIN";
    private bool CanEditUsers => Role is "SYSTEM_ADMIN" or "BRANCH_ADMIN";
    private bool CanEditUser(UserView account) => IsSystem && account.Role is ("BRANCH_ADMIN" or "EMPLOYEE")
        || Role == "BRANCH_ADMIN" && account.Role == "EMPLOYEE";
    private bool NeedsBranch => Tab is "branch-menu" or "stock" or "inventory" or "issue" or "orders" or "analytics" or "overview" or "employee-directory";
    private bool UsesDateFilter => Tab is "orders" or "analytics" or "overview";
    private string search = "", orderStatus = "", userEditor = "";
    private bool editingBranch, focusEditor;
    private ElementReference editorHeading;
    private IEnumerable<BranchView> FilteredBranches => branches.Where(b => Matches(b.Name, b.Code, b.Address));
    private IEnumerable<EmployeeDirectoryEntry> FilteredDirectory => directory.Where(e => Matches(e.FullName, e.EmployeeCode, e.BranchName, e.Position));
    private IEnumerable<UserView> FilteredUsers => users.Where(u => Matches(u.Username, u.FullName, u.BranchName));
    private IEnumerable<ManagedOrderView> FilteredOrders => orders.Where(o =>
        (orderStatus.Length == 0 || o.Status == orderStatus) && Matches(o.Code, o.EmployeeName));
    private bool Matches(params string?[] values) => string.IsNullOrWhiteSpace(search) ||
        values.Any(value => value?.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase) == true);
    private void EditBranch(BranchView value) { branch = value; editingBranch = true; focusEditor = true; }
    private void OpenUserEditor(string mode) { user = null; userEditor = mode; focusEditor = true; }
    private void EditUser(UserView value) { OpenUserEditor("edit"); user = Copy(value); }
    private void CloseUserEditor() { user = null; userEditor = ""; }
    private void FinishUserCreation() { newUser = new(); CloseUserEditor(); }
    private void FinishAssignment() { assignment = new(); CloseUserEditor(); }
    private Task SetRangeAsync(int days)
    {
        to = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
        from = to.AddDays(1 - days);
        return ReloadAsync();
    }
    private bool CanReadAll => Tab is "orders" or "analytics" or "overview" or "employee-directory";
    private bool CanAdjust => !needsLogin && !accessDenied && Role is ("SYSTEM_ADMIN" or "BRANCH_ADMIN") && order?.Status != "CANCELLED";
    private List<BranchView> branches = [];
    private List<UserView> users = [];
    private List<EmployeeDirectoryEntry> directory = [];
    private List<ManagedOrderView> orders = [];
    private List<ManagedOrderView> reportedOrders = [];
    private bool showAllReports;
    private List<RevenueView> revenue = [];
    private BranchView branch = new();
    private CreateUserRequest newUser = new();
    private AssignmentRequest assignment = new();
    private UserView? user;
    private ManagedOrderView? order;
    private int? selectedOrderId;
    private ElementReference orderHeading;
    private bool focusOrderHeading;
    private string reason = "";
    private bool confirmCancel;
    private int branchId;
    private DateOnly from = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
    private DateOnly to = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
    private bool busy;
    private bool loaded;
    private bool accessDenied;
    private bool needsLogin;
    private string? error;
    private string? notice;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Tab == "orders") from = to.AddDays(-6);
            await ReloadAsync();
            StateHasChanged();
        }
        if (focusEditor)
        {
            focusEditor = false;
            await editorHeading.FocusAsync();
        }
        if (focusOrderHeading && !busy)
        {
            focusOrderHeading = false;
            await orderHeading.FocusAsync();
        }
    }
    private async Task LoadAsync()
    {
        if (NeedsBranch || Tab is "branches" or "employees")
        {
            branches = await Api.ListAsync<BranchView>("branches");
            if (!CanReadAll && !branches.Any(b => b.Id == branchId && b.IsActive))
                branchId = branches.FirstOrDefault(b => b.IsActive)?.Id ?? 0;
        }
        string filter = $"?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}" + (branchId == 0 ? "" : $"&branchId={branchId}");
        switch (Tab)
        {
            case "employees": users = await Api.ListAsync<UserView>("users"); break;
            case "employee-directory":
                var path = branchId == 0 ? "employee-directory" : $"employee-directory?branchId={branchId}";
                directory = await Api.ListAsync<EmployeeDirectoryEntry>(path);
                break;
            case "orders":
                orders = await Api.ListAsync<ManagedOrderView>("orders" + filter);
                if (CanEditUsers)
                    reportedOrders = await Api.ListAsync<ManagedOrderView>(branchId == 0 ? "orders/reported" : $"orders/reported?branchId={branchId}");
                break;
            case "analytics":
            case "overview": revenue = await Api.ListAsync<RevenueView>("revenue" + filter); break;
        }
    }
    private async Task ReloadAsync()
    {
        if (busy) return;
        loaded = false;
        selectedOrderId = null;
        order = null;
        orders = [];
        reportedOrders = [];
        showAllReports = false;
        revenue = [];
        users = [];
        directory = [];
        await RunAsync(async () =>
        {
            if ((Tab is "orders" or "analytics" or "overview") && from > to)
                throw new ArgumentException("Ngày bắt đầu không được sau ngày kết thúc.");
            await LoadAsync();
            loaded = true;
        });
    }
    private async Task ChangeBranchAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var id)) branchId = id;
        if (CanReadAll && !UsesDateFilter) await ReloadAsync();
    }
    private Task SaveAsync(string path, int id, object input, Action reset) => RunAsync(async () =>
    {
        await Api.SaveAsync(path, id, input);
        reset();
        notice = "Đã lưu.";
        await LoadAsync();
    });
    private Task OpenOrderAsync(int id) => RunAsync(async () =>
    {
        selectedOrderId = id;
        order = null;
        reason = "";
        confirmCancel = false;
        focusOrderHeading = true;
        order = await Api.GetAsync<ManagedOrderView>($"orders/{id}");
    });
    private void CloseOrder()
    {
        if (busy) return;
        selectedOrderId = null;
        order = null;
        error = null;
        notice = null;
        accessDenied = false;
        needsLogin = false;
        focusOrderHeading = true;
    }
    private Task AdjustAsync(bool cancel) => RunAsync(async () =>
    {
        if (order is not { } current || !CanAdjust || (cancel && !confirmCancel)) return;

        if (cancel)
        {
            await Api.PostAsync(
                $"orders/{current.Id}/cancel",
                new CancelOrderRequest
                {
                    Reason = reason,
                    RowVersion = current.RowVersion
                });

            notice = "Đã hủy đơn.";
        }
        else
        {
            await Api.PutAsync(
                $"orders/{current.Id}",
                new AdjustOrderRequest
                {
                    Reason = reason,
                    RowVersion = current.RowVersion,
                    Items = current.Items
                        .Select(x => new QuantityChange
                        {
                            ItemId = x.Id,
                            Quantity = x.Quantity
                        })
                        .ToList()
                });

            notice = "Đã cập nhật số ly.";
        }

        confirmCancel = false;
        reason = "";

        // Drop the old row version even if refreshing the saved order fails.
        order = null;
        order = await Api.GetAsync<ManagedOrderView>($"orders/{current.Id}");
        await LoadAsync();
    });
    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null; notice = null; needsLogin = false; accessDenied = false;
        await InvokeAsync(StateHasChanged);
        try { await action(); }
        catch (ApiException ex) { error = ex.Message; notice = null; needsLogin = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized; accessDenied = ex.StatusCode == System.Net.HttpStatusCode.Forbidden; }
        catch (ArgumentException ex) { error = ex.Message; notice = null; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { notice = null; error = "Không nhận được phản hồi. Hãy tải lại để kiểm tra trước khi thao tác tiếp."; }
        finally { busy = false; }
    }
    private static string Money(decimal value) => BranchFlow.Web.Components.Orders.Display.Money(value);
    private static string VietnamTime(DateTime utc) => utc.AddHours(7).ToString("dd/MM/yyyy HH:mm");
    private static T Copy<T>(T value) => System.Text.Json.JsonSerializer.Deserialize<T>(System.Text.Json.JsonSerializer.Serialize(value))!;
    private static string DescribeAdjustment(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            return $"{root.GetProperty("Status").GetString()} · {Money(root.GetProperty("TotalAmount").GetDecimal())} · " +
                string.Join(", ", root.GetProperty("Items").EnumerateArray().Select(x => $"{x.GetProperty("ProductNameSnapshot").GetString()} × {x.GetProperty("Quantity").GetInt32()}"));
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or KeyNotFoundException or InvalidOperationException or FormatException)
        { return "Bản ghi lịch sử từ phiên bản trước."; }
    }
}

@inject ManagementApiClient Api
@inject BranchFlow.Web.Services.Auth.WebSessionStore Sessions

<section class="business-panel password-support" aria-labelledby="support-title">
    <div class="panel-heading"><h2 id="support-title">Hỗ trợ mật khẩu</h2><button class="btn btn-outline-secondary" disabled="@busy" @onclick="LoadAsync">Tải yêu cầu</button></div>
    <p>Chỉ cấp mật khẩu tạm sau khi đã xác minh qua kênh liên lạc của nhân viên. Mật khẩu tạm có hiệu lực 30 phút và buộc đổi khi đăng nhập.</p>
    @if (message is not null) { <p class="alert alert-info" role="status">@message</p> }
    @if (pending.Count > 0)
    {
        <ul class="password-requests">@foreach (var request in pending) { <li><span>@request.FullName · @request.Username · @request.RequestedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM HH:mm")</span> <button class="btn btn-outline-secondary" disabled="@busy" @onclick="() => Select(request.UserId)">Xử lý yêu cầu</button></li> }</ul>
    }
    else { <p>Không có yêu cầu chờ xử lý trong danh sách đã tải.</p> }
    <div class="password-fields">
        <label for="reset-target">Tài khoản cần hỗ trợ</label>
        <select id="reset-target" class="form-select" value="@target" @onchange="TargetChanged" disabled="@busy">
            <option value="0">Chọn tài khoản</option>
            @foreach (var u in Users.Where(x => x.IsActive && x.Role is "EMPLOYEE" or "BRANCH_ADMIN")) { <option value="@u.Id">@u.FullName · @u.Username</option> }
        </select>
        <label for="reset-reason">Lý do cấp mật khẩu tạm</label>
        <select class="form-select" id="reset-reason" @bind="reason" disabled="@busy">
            <option value="">Chọn lý do</option><option value="Người dùng quên mật khẩu">Người dùng quên mật khẩu</option><option value="Mật khẩu tạm đã hết hạn">Mật khẩu tạm đã hết hạn</option><option value="Nghi ngờ thông tin đăng nhập bị lộ">Nghi ngờ thông tin đăng nhập bị lộ</option>
        </select>
        <label class="password-confirm"><input type="checkbox" @bind="verified" disabled="@busy" /> Tôi đã xác minh danh tính người nhận qua kênh liên lạc đã biết.</label>
        <button class="btn btn-brand" disabled="@(busy || target <= 0 || !verified || reason.Length == 0)" @onclick="ResetAsync">@(busy ? "Đang xử lý…" : "Cấp mật khẩu tạm và kết thúc phiên cũ")</button>
    </div>
    @if (issued is not null)
    {
        <div class="alert alert-warning password-issued" role="status">
            <strong>Mật khẩu tạm cho @issued.Username</strong>
            <p>Gửi riêng cho đúng người đã xác minh. Mật khẩu chỉ xuất hiện trong lần cấp này; hệ thống không lưu bản có thể đọc lại.</p>
            <output class="temporary-password">@issued.TemporaryPassword</output>
            <p>Hết hạn: @issued.ExpiresAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") (giờ Việt Nam).</p>
            <button class="btn btn-outline-secondary" @onclick="() => issued = null">Đã bàn giao, ẩn mật khẩu</button>
        </div>
    }
</section>
@code {
    [Parameter] public List<UserView> Users { get; set; } = [];
    [Parameter] public int TargetUserId { get; set; }
    private int target, lastParameter;
    private bool busy, verified;
    private string reason = "";
    private string? message;
    private TemporaryPasswordResult? issued;
    private List<PasswordSupportRequest> pending = [];
    protected override async Task OnInitializedAsync() => await LoadAsync();
    protected override void OnParametersSet() { if (TargetUserId != lastParameter) { lastParameter = TargetUserId; Select(TargetUserId); } }
    private void Select(int id) { target = id; verified = false; reason = ""; issued = null; message = null; }
    private void TargetChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var id)) Select(id); }
    private async Task LoadAsync()
    {
        try { pending = await Api.ListAsync<PasswordSupportRequest>("password-requests"); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { message = "Chưa tải được yêu cầu hỗ trợ. Vui lòng thử lại."; }
    }
    private async Task ResetAsync()
    {
        if (busy || !verified || target <= 0) return;
        busy = true; issued = null; message = null;
        try
        {
            issued = await Api.ResetPasswordAsync(target, new(true, reason));
            Sessions.RemoveForUser(target);
            verified = false; reason = "";
            await LoadAsync();
        }
        catch (ApiException ex) { message = ex.Message; }
        catch (HttpRequestException) { message = "Chưa xác nhận được kết quả. Vui lòng kiểm tra lại trước khi cấp tiếp."; }
        finally { busy = false; }
    }
}

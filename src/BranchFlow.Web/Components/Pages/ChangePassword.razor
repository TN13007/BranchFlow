@page "/change-password"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout

<PageTitle>Đổi mật khẩu | BranchFlow</PageTitle>
<section class="password-card business-panel" aria-labelledby="password-title">
    <h1 id="password-title">Đổi mật khẩu</h1>
    <p>Nếu đang dùng mật khẩu tạm, bạn cần đổi trước khi sử dụng hệ thống. Sau khi đổi thành công, tất cả phiên cũ sẽ kết thúc.</p>
    @if (Error is not null)
    {
        <p class="alert alert-danger" role="alert">@(Error == "rate" ? "Bạn đã thử nhiều lần. Vui lòng chờ một phút." : Error == "service" ? "Dịch vụ tạm thời chưa sẵn sàng. Vui lòng thử lại." : "Kiểm tra mật khẩu hiện tại, mật khẩu mới (12–128 ký tự, khác mật khẩu cũ) và phần xác nhận.")</p>
    }
    <form action="/auth/change-password" method="post" data-enhance="false">
        <AntiforgeryToken />
        <label for="currentPassword">Mật khẩu hiện tại hoặc mật khẩu tạm</label>
        <input class="form-control" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" maxlength="128" required />
        <label for="newPassword">Mật khẩu mới</label>
        <input class="form-control" id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required aria-describedby="password-hint" />
        <small id="password-hint">12–128 ký tự, khác mật khẩu hiện tại. Nên dùng một cụm từ dài, dễ nhớ với riêng bạn.</small>
        <label for="confirmPassword">Nhập lại mật khẩu mới</label>
        <input class="form-control" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
        <button class="btn btn-brand" type="submit">Lưu mật khẩu mới</button>
    </form>
    <form action="/auth/logout" method="post" data-enhance="false"><AntiforgeryToken /><button class="btn btn-outline-secondary" type="submit">Đăng xuất</button></form>
</section>
@code { [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; } }

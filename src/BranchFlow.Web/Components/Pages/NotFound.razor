@page "/not-found"
@layout EmployeeLayout

<PageTitle>Không tìm thấy trang | BranchFlow</PageTitle>

<header class="page-heading">
    <div>
        <p class="eyebrow">ĐIỀU HƯỚNG HỆ THỐNG</p>
        <h1>Không tìm thấy trang</h1>
        <p>Đường dẫn bạn truy cập không tồn tại hoặc đã thay đổi.</p>
    </div>
</header>

<div class="page-content">
    <div class="empty-state" role="status">
        <img class="empty-state-figure decor-non-interactive" src="/images/christmas/scenes/empty-gingerbread-cocoa.jpg" alt="" />
        <strong>Không tìm thấy nội dung yêu cầu</strong>
        <p class="mb-3 mt-1">Vui lòng kiểm tra lại địa chỉ hoặc quay về trang chính của ứng dụng.</p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a href="/" class="btn btn-brand">Về trang chủ</a>
            <a href="/login" class="btn btn-outline-secondary" style="min-height:44px;display:inline-flex;align-items:center;">Đăng nhập</a>
        </div>
    </div>
</div>

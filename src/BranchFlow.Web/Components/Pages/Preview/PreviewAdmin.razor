@page "/preview/admin"
@layout EmployeeLayout
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Xem thử Quản trị (ADMIN) | BranchFlow</PageTitle>

@if (Environment.IsDevelopment())
{
    <div class="preview-banner @ActiveSceneClass" role="status">
        <span><strong>DỮ LIỆU MẪU (DEVELOPMENT)</strong> · Page Figma <code>153:973</code> (Giáng sinh · 02 Quản trị). Phân biệt rõ quyền <strong>BRANCH_ADMIN</strong> và <strong>SYSTEM_ADMIN</strong>.</span>
        <PreviewRoleSwitcher CurrentRole="admin" />
    </div>

    <header class="page-heading">
        <div>
            <p class="eyebrow">QUẢN TRỊ HỆ THỐNG &amp; CHI NHÁNH · MỐC FIGMA @ActiveNodeId</p>
            <h1>@ActiveTitle</h1>
            <p>Bản xem thử giao diện tĩnh dùng shell hiện hành (bỏ qua các frame "Phiên bản trước"). Thao tác bật/tắt dưới đây chỉ minh họa trạng thái UI.</p>
        </div>
        <span class="status-badge needs-review">Bản xem thử tĩnh · Chưa nối API quản trị</span>
    </header>

    <div class="page-content">
        <div id="admin-tablist" class="atelier-subnav" role="tablist" aria-label="Các màn hình Quản trị">
            @for (var i = 0; i < tabs.Count; i++)
            {
                var idx = i;
                var tab = tabs[i];
                var isSelected = activeTab == tab.Key;
                <button id="admin-tab-@tab.Key"
                        type="button"
                        class="chip @(isSelected ? "selected" : "")"
                        role="tab"
                        aria-selected="@(isSelected ? "true" : "false")"
                        aria-controls="admin-tabpanel"
                        tabindex="@(isSelected ? 0 : -1)"
                        @onclick="() => activeTab = tab.Key"
                        @onkeydown="e => OnTabKeyDownAsync(e, idx)">
                    @tab.Label
                </button>
            }
        </div>

        <div id="admin-tabpanel" role="tabpanel" aria-labelledby="admin-tab-@activeTab">
            @if (activeTab == "branch-menu")
            {
                <section class="surface-card">
                    <div class="atelier-role-header">
                        <div>
                            <p class="eyebrow mb-1">BRANCH_ADMIN · CHI NHÁNH QUẬN 1 (NODE 165:21555 &amp; 165:22617)</p>
                            <h2 class="mb-0">Quản lý trạng thái mở bán tại chi nhánh</h2>
                        </div>
                        <span class="status-badge completed">✓ Quyền: Chỉ bật/tắt tại chi nhánh hiệu lực (Không sửa giá gốc)</span>
                    </div>
                    <p class="text-secondary mb-3">
                        Quản trị chi nhánh chỉ bật hoặc tạm ngừng bán món/topping tại chi nhánh mình phụ trách. Khi món tạm ngừng, nhân viên tại chi nhánh sẽ không thể tạo đơn mới với món đó.
                    </p>

                    @if (pauseTarget is not null)
                    {
                        <div class="alert alert-warning mb-3" role="region" aria-label="Xác nhận tạm ngừng món">
                            <strong>Xác nhận tạm ngừng bán món "@pauseTarget" tại Chi nhánh Quận 1 (Node 165:22617):</strong>
                            <p class="mb-2 mt-1">Lý do mẫu: Tạm hết nguyên liệu tươi trong ca chiều. (Minh họa UI tĩnh)</p>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-danger fw-semibold" style="min-height:44px;padding:8px 14px;" @onclick="ConfirmPause">Xác nhận tạm ngừng (Mẫu)</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold" style="min-height:44px;padding:8px 14px;" @onclick="() => pauseTarget = null">Hủy</button>
                            </div>
                        </div>
                    }

                    <div class="table-scroll">
                        <table class="atelier-table">
                            <thead>
                                <tr>
                                    <th>Tên món</th>
                                    <th>Danh mục</th>
                                    <th class="num">Giá gốc (Size M / L)</th>
                                    <th>Trạng thái tại Q1</th>
                                    <th>Thao tác nghiệp vụ (Mẫu)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in branchItems)
                                {
                                    <tr>
                                        <td><strong>@item.Name</strong></td>
                                        <td>@item.Category</td>
                                        <td class="num">@item.PriceText</td>
                                        <td>
                                            @if (item.Available)
                                            {
                                                <span class="status-badge completed">✓ Đang mở bán</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge cancelled">× Tạm ngừng tại CN</span>
                                            }
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm @(item.Available ? "btn-outline-danger" : "btn-outline-success") fw-semibold"
                                                    style="min-height:44px;padding:8px 14px;"
                                                    @onclick="() => ToggleBranchItem(item)">
                                                @(item.Available ? "Tạm ngừng bán" : "Mở bán lại")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
            else if (activeTab == "system-menu")
            {
                <section class="surface-card">
                    <div class="atelier-role-header">
                        <div>
                            <p class="eyebrow mb-1">SYSTEM_ADMIN · DỮ LIỆU TỔNG (NODE 165:22086 &amp; 165:21399)</p>
                            <h2 class="mb-0">Danh mục chung &amp; Bảng giá toàn hệ thống</h2>
                        </div>
                        <span class="status-badge completed">✓ Quyền: Quản trị danh mục và giá chuẩn</span>
                    </div>
                    <div class="table-scroll">
                        <table class="atelier-table">
                            <thead>
                                <tr>
                                    <th>Mã ProductSize</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Danh mục</th>
                                    <th>Size</th>
                                    <th class="num">Giá niêm yết</th>
                                    <th>Trạng thái toàn cục</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>#101</code></td>
                                    <td><strong>Trà đào cam sả</strong></td>
                                    <td>Trà trái cây</td>
                                    <td>Size M</td>
                                    <td class="num">30.000đ</td>
                                    <td><span class="status-badge completed">✓ Đang áp dụng</span></td>
                                </tr>
                                <tr>
                                    <td><code>#102</code></td>
                                    <td><strong>Trà đào cam sả</strong></td>
                                    <td>Trà trái cây</td>
                                    <td>Size L</td>
                                    <td class="num">38.000đ</td>
                                    <td><span class="status-badge completed">✓ Đang áp dụng</span></td>
                                </tr>
                                <tr>
                                    <td><code>#104</code></td>
                                    <td><strong>Cà phê sữa đá</strong></td>
                                    <td>Cà phê</td>
                                    <td>Size M</td>
                                    <td class="num">32.000đ</td>
                                    <td><span class="status-badge completed">✓ Đang áp dụng</span></td>
                                </tr>
                                <tr>
                                    <td><code>#106</code></td>
                                    <td><strong>Matcha latte</strong></td>
                                    <td>Sữa tươi</td>
                                    <td>Size M</td>
                                    <td class="num">52.000đ</td>
                                    <td><span class="status-badge completed">✓ Đang áp dụng</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            }
            else if (activeTab == "stocktake")
            {
                <section class="surface-card">
                    <p class="eyebrow mb-1">BRANCH_ADMIN · DUYỆT KIỂM KHO (NODE 165:21430 / 165:21460 / 165:21486)</p>
                    <h2>Phiếu kiểm kê kho nguyên liệu cuối ca</h2>
                    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Trạng thái phiếu kiểm kho">
                        <button type="button" class="chip @(stockState == "PENDING" ? "selected" : "")" aria-pressed="@(stockState == "PENDING" ? "true" : "false")" @onclick='() => stockState = "PENDING"'>Chờ duyệt (165:21430)</button>
                        <button type="button" class="chip @(stockState == "APPROVED" ? "selected" : "")" aria-pressed="@(stockState == "APPROVED" ? "true" : "false")" @onclick='() => stockState = "APPROVED"'>Đã duyệt (165:21460)</button>
                        <button type="button" class="chip @(stockState == "REJECTED" ? "selected" : "")" aria-pressed="@(stockState == "REJECTED" ? "true" : "false")" @onclick='() => stockState = "REJECTED"'>Từ chối (165:21486)</button>
                    </div>
                    <div class="alert @(stockState == "APPROVED" ? "alert-success" : stockState == "REJECTED" ? "alert-danger" : "alert-warning")" role="status">
                        @if (stockState == "PENDING")
                        {
                            <span><strong>Trạng thái phiếu KK-Q1-20261104:</strong> Chờ quản lý chi nhánh đối chiếu chênh lệch trước khi chốt sổ kho.</span>
                        }
                        else if (stockState == "APPROVED")
                        {
                            <span><strong>Trạng thái phiếu KK-Q1-20261104:</strong> ✓ Đã duyệt và cập nhật số dư tồn kho thực tế.</span>
                        }
                        else
                        {
                            <span><strong>Trạng thái phiếu KK-Q1-20261104:</strong> × Đã từ chối — Yêu cầu nhân viên ca tối đếm lại Bột Matcha Uji.</span>
                        }
                    </div>
                    <div class="table-scroll">
                        <table class="atelier-table">
                            <thead>
                                <tr>
                                    <th>Nguyên liệu</th>
                                    <th>Đơn vị</th>
                                    <th class="num">Tồn sổ sách</th>
                                    <th class="num">Kiểm đếm thực tế</th>
                                    <th class="num">Chênh lệch</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Trà đào túi lọc</strong></td>
                                    <td>Hộp</td>
                                    <td class="num">12,0</td>
                                    <td class="num">12,0</td>
                                    <td class="num">0,0</td>
                                </tr>
                                <tr>
                                    <td><strong>Trân châu đen</strong></td>
                                    <td>Kg</td>
                                    <td class="num">6,5</td>
                                    <td class="num">6,3</td>
                                    <td class="num">-0,2</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            }
            else if (activeTab == "transfer")
            {
                <section class="surface-card">
                    <p class="eyebrow mb-1">ĐIỀU CHUYỂN NHÂN SỰ (NODE 165:21512 &amp; 165:21530)</p>
                    <h2>Đề nghị điều chuyển chi nhánh &amp; Phiếu chờ xác nhận</h2>
                    <div class="table-scroll">
                        <table class="atelier-table">
                            <thead>
                                <tr>
                                    <th>Mã phiếu</th>
                                    <th>Nhân viên</th>
                                    <th>Từ chi nhánh</th>
                                    <th>Sang chi nhánh</th>
                                    <th>Ngày hiệu lực dự kiến</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>TR-202611-01</strong></td>
                                    <td>employee04 · Võ Hoàng Yến</td>
                                    <td>Q3 · Quận 3</td>
                                    <td>Q1 · Quận 1</td>
                                    <td>10/11/2026 (UTC)</td>
                                    <td><span class="status-badge needs-review">! Chờ xác nhận</span></td>
                                </tr>
                                <tr>
                                    <td><strong>TR-202610-09</strong></td>
                                    <td>employee09 · Đặng Gia Huy</td>
                                    <td>Q1 · Quận 1</td>
                                    <td>TD · Thảo Điền</td>
                                    <td>25/10/2026 (UTC)</td>
                                    <td><span class="status-badge completed">✓ Đã hoàn tất</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            }
            else if (activeTab == "branches")
            {
                <section class="surface-card">
                    <p class="eyebrow mb-1">SYSTEM_ADMIN · CHI NHÁNH &amp; QUẢN LÝ (NODE 165:21541)</p>
                    <h2>Danh sách chi nhánh và Admin phụ trách hiệu lực</h2>
                    <div class="table-scroll">
                        <table class="atelier-table">
                            <thead>
                                <tr>
                                    <th>Mã CN</th>
                                    <th>Tên chi nhánh</th>
                                    <th>Quản lý hiện tại (BRANCH_ADMIN)</th>
                                    <th>Hiệu lực từ</th>
                                    <th>Trạng thái chi nhánh</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Q1</strong></td>
                                    <td>Chi nhánh Quận 1</td>
                                    <td>branchadmin_q1 · Trần Minh Quân</td>
                                    <td>01/10/2026</td>
                                    <td><span class="status-badge completed">✓ Đang hoạt động</span></td>
                                </tr>
                                <tr>
                                    <td><strong>Q3</strong></td>
                                    <td>Chi nhánh Quận 3</td>
                                    <td>branchadmin_q3 · Lê Thu Hà</td>
                                    <td>01/10/2026</td>
                                    <td><span class="status-badge completed">✓ Đang hoạt động</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    </div>
}
else
{
    <div class="page-content"><h1>Không tìm thấy trang</h1></div>
}

@code {
    private string activeTab = "branch-menu";
    private string stockState = "PENDING";
    private string? pauseTarget;
    private IJSObjectReference? module;

    private sealed class BranchMenuItem(string name, string category, string priceText, bool available)
    {
        public string Name { get; } = name;
        public string Category { get; } = category;
        public string PriceText { get; } = priceText;
        public bool Available { get; set; } = available;
    }

    private readonly List<BranchMenuItem> branchItems =
    [
        new("Trà đào cam sả", "Trà trái cây", "30.000đ / 38.000đ", true),
        new("Trà vải", "Trà trái cây", "42.000đ", true),
        new("Cà phê sữa đá", "Cà phê", "32.000đ", true),
        new("Bạc xỉu", "Cà phê", "38.000đ", false),
        new("Matcha latte", "Sữa tươi", "52.000đ", true)
    ];

    private void ToggleBranchItem(BranchMenuItem item)
    {
        if (item.Available)
        {
            pauseTarget = item.Name;
        }
        else
        {
            item.Available = true;
            pauseTarget = null;
        }
    }

    private void ConfirmPause()
    {
        var item = branchItems.FirstOrDefault(x => x.Name == pauseTarget);
        if (item is not null) item.Available = false;
        pauseTarget = null;
    }

    private sealed record TabItem(string Key, string Label, string NodeId, string Title);

    private static readonly IReadOnlyList<TabItem> tabs =
    [
        new("branch-menu", "01 · Menu Chi nhánh (BRANCH_ADMIN)", "165:21555", "Menu Chi nhánh & Tạm ngừng món"),
        new("system-menu", "02 · Menu Tổng (SYSTEM_ADMIN)", "165:22086", "Menu Dùng chung & Danh mục"),
        new("stocktake", "03 · Duyệt Kiểm kho", "165:21430", "Kiểm kho Chờ duyệt / Duyệt / Từ chối"),
        new("transfer", "04 · Điều chuyển", "165:21512", "Đề nghị & Duyệt điều chuyển"),
        new("branches", "05 · Chi nhánh & Quản lý", "165:21541", "Chi nhánh và Người quản lý")
    ];

    private string ActiveNodeId => tabs.First(t => t.Key == activeTab).NodeId;
    private string ActiveTitle => tabs.First(t => t.Key == activeTab).Title;
    private string ActiveSceneClass => activeTab switch
    {
        "stocktake" or "transfer" => "context-scene-snow-storehouse",
        _ => "context-scene-village-overview"
    };

    private async Task OnTabKeyDownAsync(KeyboardEventArgs e, int currentIndex)
    {
        var nextIndex = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => (currentIndex + 1) % tabs.Count,
            "ArrowLeft" or "ArrowUp" => (currentIndex - 1 + tabs.Count) % tabs.Count,
            "Home" => 0,
            "End" => tabs.Count - 1,
            _ => -1
        };
        if (nextIndex < 0) return;
        activeTab = tabs[nextIndex].Key;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/order-ui.js");
        await module.InvokeVoidAsync("focusTab", "admin-tablist", nextIndex);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null) try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}

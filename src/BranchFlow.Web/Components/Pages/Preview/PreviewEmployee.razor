@page "/preview/employee"
@layout EmployeeLayout
@using BranchFlow.Web.Models.Appearance
@inject IWebHostEnvironment Environment
@inject BranchFlow.Web.Services.Preview.WarehousePreviewState StockState
@implements IDisposable

<PageTitle>Xem thử Nhân viên mở rộng (EMPLOYEE) | BranchFlow</PageTitle>

@if (Environment.IsDevelopment())
{
    <div class="employee-birch-board @(activeTab == "home" ? "employee-room-approved" : activeTab == "stock" ? "employee-stock-warehouses" : "")" data-figma-page="153:974">
    <div class="preview-banner" role="status">
        <span><strong>KHÔNG GIAN XEM THỬ</strong> · Dữ liệu minh họa, chưa kết nối API.</span>
        <PreviewRoleSwitcher CurrentRole="employee" />
    </div>

    <div class="employee-room-scene">
    @if (activeTab == "stock")
    {
        <BranchFlow.Web.Components.Inventory.WarehouseStockPreview Warehouses="StockState.Warehouses" />
    }
    else
    {
    <header class="page-heading birch-heading" data-figma-node="@ActiveNodeId">
        <div>
            <p class="eyebrow">XƯỞNG QUÀ MÙA ĐÔNG · GÓC NHÂN VIÊN</p>
            <h1>@ActiveTitle</h1>
            <p>Một góc nhỏ để theo dõi ca làm và chuẩn bị quầy thật chu đáo.</p>
        </div>
        <a href="/preview/orders" class="btn btn-brand">Đến quầy gọi món <span aria-hidden="true">↗</span></a>
    </header>

    <div class="page-content birch-content">
        <section id="employee-board-content" class="board-details" aria-label="@ActiveTitle">
            @if (activeTab != "home")
            {
                <div class="board-seasonal-decor" aria-hidden="true">
                    <img class="board-decor-top" src="/images/christmas/employee-board/decorations/fir-lights-top-v2.png" alt="" />
                    <img class="board-decor-left" src="/images/christmas/employee-board/decorations/fir-candy-left-v2.png" alt="" />
                    <img class="board-decor-right" src="/images/christmas/employee-board/decorations/fir-peppermint-right-v2.png" alt="" />
                    <img class="board-decor-gifts" src="/images/christmas/employee-board/gifts-and-candy-v1.png" alt="" />
                </div>
            }
            @if (activeTab == "home")
            {
                <div class="board-section-heading"><p class="eyebrow">SỔ CA LÀM</p><h2>Ca làm của bạn</h2><p>Ca sáng · 07:00 – 15:00</p></div>
                <ol class="board-card-list">
                    <li class="board-card">
                        <span class="board-card-index" aria-hidden="true">01</span>
                        <h3 class="kpi-label">Chi nhánh phân công</h3>
                        <div class="kpi-value">Q1 · Quận 1</div>
                        <div class="kpi-note">Ca sáng mùa lễ hội (07:00 – 15:00)</div>
                    </li>
                    <li class="board-card">
                        <span class="board-card-index" aria-hidden="true">02</span>
                        <h3 class="kpi-label">Đơn đã tạo trong ca</h3>
                        <div class="kpi-value">18 đơn</div>
                        <div class="kpi-note">39 ly đồ uống · 100% Hoàn tất</div>
                    </li>
                    <li class="board-card">
                        <span class="board-card-index" aria-hidden="true">03</span>
                        <h3 class="kpi-label">Món đang mở bán</h3>
                        <div class="kpi-value">5 đồ uống</div>
                        <div class="kpi-note">2 loại topping (tối đa 3 phần/loại)</div>
                    </li>
                    <li class="board-card board-card-pending">
                        <span class="board-card-index" aria-hidden="true">04</span>
                        <h3 class="kpi-label">Phiếu kiểm kho cuối ca</h3>
                        <div class="kpi-value">Chưa gửi</div>
                        <div class="kpi-note">Thực hiện trước 14:45 khi bàn giao ca</div>
                        <span class="board-note">Cần hoàn tất trước khi kết ca</span>
                    </li>
                </ol>
            }
            else if (activeTab == "stocktake")
            {
                <div class="board-section-heading"><p class="eyebrow">SỔ BÀN GIAO</p><h2>Kiểm kho cuối ca</h2><p>Bản xem trước kết quả kiểm đếm, chưa gửi phiếu lên hệ thống.</p></div>
                <ol class="board-card-list">
                    <li class="board-card">
                        <span class="board-card-index" aria-hidden="true">01</span>
                        <h3>Hạt cà phê rang mộc</h3>
                        <dl class="board-facts">
                            <div><dt>Số dư hệ thống</dt><dd>8,0 kg</dd></div>
                            <div><dt>Số đếm thực tế (mẫu)</dt><dd>8,0 kg</dd></div>
                            <div><dt>Ghi chú</dt><dd><span class="status-badge completed">✓ Khớp sổ sách</span></dd></div>
                        </dl>
                    </li>
                    <li class="board-card">
                        <span class="board-card-index" aria-hidden="true">02</span>
                        <h3>Sữa tươi thanh trùng</h3>
                        <dl class="board-facts">
                            <div><dt>Số dư hệ thống</dt><dd>24 hộp 1L</dd></div>
                            <div><dt>Số đếm thực tế (mẫu)</dt><dd>24 hộp 1L</dd></div>
                            <div><dt>Ghi chú</dt><dd><span class="status-badge completed">✓ Khớp sổ sách</span></dd></div>
                        </dl>
                    </li>
                </ol>
            }
            else if (activeTab == "profile")
            {
                <div class="board-section-heading"><p class="eyebrow">THẺ NHÂN VIÊN</p><h2>Hồ sơ &amp; Phân công</h2><p>Thông tin phân công đang có hiệu lực.</p></div>
                <dl class="board-card-list board-profile">
                    <div class="board-card"><dt>Họ và tên nhân viên</dt><dd>Nguyễn Công Thành <small>employee01</small></dd></div>
                    <div class="board-card"><dt>Vai trò</dt><dd>Nhân viên bán hàng <small>EMPLOYEE</small></dd></div>
                    <div class="board-card"><dt>Chi nhánh hiện hành</dt><dd>Q1 · Chi nhánh Quận 1 <small>Chỉ có một chi nhánh hiệu lực tại một thời điểm.</small></dd></div>
                    <div class="board-card"><dt>Thời gian hiệu lực (UTC)</dt><dd>Từ 01/10/2026 <small>Đang có hiệu lực</small></dd></div>
                </dl>
            }
            else if (activeTab == "payroll")
            {
                <div class="board-section-heading"><p class="eyebrow">PHIẾU LƯƠNG</p><h2>Lương cá nhân</h2><p>Các khoản dưới đây là số liệu minh họa.</p></div>
                    <ol class="board-card-list">
                        <li class="board-card">
                            <h3 class="kpi-label">Kỳ lương</h3>
                            <div class="kpi-value">Tháng 11/2026</div>
                            <div class="kpi-note">Cập nhật đến ngày 04/11/2026</div>
                        </li>
                        <li class="board-card">
                            <h3 class="kpi-label">Số ca đã ghi nhận</h3>
                            <div class="kpi-value">21 ca</div>
                            <div class="kpi-note">168 giờ làm việc hợp lệ</div>
                        </li>
                        <li class="board-card">
                            <h3 class="kpi-label">Lương theo giờ</h3>
                            <div class="kpi-value">6.720.000đ</div>
                            <div class="kpi-note">40.000đ / giờ tiêu chuẩn</div>
                        </li>
                        <li class="board-card board-card-total">
                            <h3 class="kpi-label">Tổng thực lĩnh tạm tính</h3>
                            <div class="kpi-value">7.370.000đ</div>
                            <div class="kpi-note">Đã gồm phụ cấp ca lễ hội 650.000đ</div>
                        </li>
                    </ol>
            }
        </section>
    </div>
    }
    </div>
    </div>
}
else
{
    <div class="page-content"><h1>Không tìm thấy trang</h1></div>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? RequestedTab { get; set; }
    private EmployeeBoardSection selectedSection = EmployeeBoardSection.All[0];
    private string activeTab => selectedSection.Key;
    private string ActiveNodeId => selectedSection.FigmaNode;
    private string ActiveTitle => selectedSection.Title;

    protected override void OnParametersSet() => selectedSection = EmployeeBoardSection.FromKey(RequestedTab);
    protected override void OnInitialized() => StockState.Changed += OnStockChanged;
    private void OnStockChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => StockState.Changed -= OnStockChanged;
}

@page "/employee"
@page "/owner"
@page "/admin"
@attribute [Authorize]
@layout EmployeeLayout
@using BranchFlow.Web.Models.Appearance
@using BranchFlow.Web.Components.Business
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject OrderApiClient Api

<PageTitle>@title | BranchFlow</PageTitle>

@if (!allowed)
{
    <header class="page-heading"><div><h1>Không có quyền truy cập</h1><p>Chức năng này không thuộc vai trò của bạn.</p></div></header>
    <div class="page-content"><a class="btn btn-brand" href="@WorkspaceNavigation.Home(role)">Về trang chủ</a></div>
}
else if (section is null)
{
    <header class="page-heading"><div><h1>Không tìm thấy chức năng</h1></div></header>
    <div class="page-content"><a class="btn btn-brand" href="@WorkspaceNavigation.Home(role)">Về trang chủ</a></div>
}
else
{
    @if (role == "OWNER")
    {
        <div class="readonly-strip"><img src="/images/christmas/icons/icon-check.svg" alt="" /><strong>Chủ sở hữu</strong><span>Chỉ xem dữ liệu</span></div>
    }
    <header class="page-heading business-page-heading">
        <div><p class="eyebrow">BRANCHFLOW · @Today.ToString("dd/MM/yyyy")</p><h1>@title</h1><p>@subtitle</p></div>
        <span class="workspace-role-badge">@WorkspaceNavigation.RoleLabel(role)</span>
    </header>
    <div class="page-content business-content">
        @if (IsOverview && role == "EMPLOYEE")
        {
                <ApiError Message="@error" NeedsLogin="needsLogin" OnRetry="LoadEmployeeAsync" Busy="loading" />
                <div class="business-filters"><div class="scope-card"><span>Chi nhánh</span><strong>@(branch is null ? "Chưa có dữ liệu" : $"{branch.Code} · {branch.Name}")</strong></div><div class="scope-card"><span>Thời gian</span><strong>Hôm nay · @Today.ToString("dd/MM")</strong></div><button class="btn btn-outline-secondary" disabled="@loading" @onclick="LoadEmployeeAsync">@(loading ? "Đang tải…" : "Tải lại")</button></div>
                <div class="business-metrics">
                    <article class="metric-tile primary"><span class="metric-label">ĐƠN CỦA TÔI HÔM NAY</span><strong>@(hasEmployeeData ? orders.Count.ToString() : "—")</strong><small>@(loading ? "Đang tải dữ liệu" : "Theo ngày kinh doanh")</small></article>
                    <article class="metric-tile"><span class="metric-label">ĐÃ HOÀN TẤT</span><strong>@(hasEmployeeData ? orders.Count(o => o.Status == "COMPLETED").ToString() : "—")</strong><small>Đơn hàng hoàn tất</small></article>
                    <article class="metric-tile"><span class="metric-label">SỐ LY</span><strong>@(hasEmployeeData ? orders.Sum(o => (long)o.TotalQuantity).ToString() : "—")</strong><small>Trong các đơn hôm nay</small></article>
                    <article class="metric-tile"><span class="metric-label">MÓN MỞ BÁN</span><strong>@(menu is null ? "—" : menu.Categories.Sum(c => c.Products.Count).ToString())</strong><small>Menu chi nhánh</small></article>
                </div>
                <section class="business-panel"><div class="panel-heading"><h2>Thao tác nhanh</h2></div><div class="quick-action-grid"><a href="/orders/create"><img src="/images/icons/coffee.svg" alt="" /><strong>Gọi món</strong><span>Tạo đơn mới →</span></a><a href="/orders/mine"><img src="/images/christmas/icons/icon-orders.svg" alt="" /><strong>Đơn của tôi</strong><span>Tra cứu đơn →</span></a><a href="/employee?tab=stock"><img src="/images/christmas/icons/icon-box.svg" alt="" /><strong>Tồn kho</strong><span>Xem nguyên liệu →</span></a><a href="/employee?tab=issue"><img src="/images/christmas/icons/icon-stocktake.svg" alt="" /><strong>Xuất kho</strong><span>Ghi giao dịch →</span></a></div></section>
                <section class="business-panel"><div class="panel-heading"><h2>Đơn gần đây</h2><a href="/orders/mine">Xem tất cả →</a></div>
                    @if (hasEmployeeData && orders.Count > 0)
                    {
                        <div class="recent-business-orders">@foreach (var order in orders.OrderByDescending(o => o.CreatedAt).Take(5)) { <a href="@($"/orders/{order.Id}")"><span><strong>@order.Code</strong><small>@order.TotalQuantity ly · @order.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</small></span><span><strong>@Money(order.TotalAmount)</strong><StatusBadge Status="@order.Status" /></span></a> }</div>
                    }
                    else
                    {
                        <div class="business-empty"><img src="/images/christmas/icons/icon-orders.svg" alt="" /><h3>@(loading ? "Đang tải đơn hàng" : hasEmployeeData ? "Chưa có đơn hôm nay" : "Chưa tải được đơn hàng")</h3><p>@(hasEmployeeData ? "Đơn mới sẽ xuất hiện tại đây." : "Kiểm tra kết nối và thử tải lại.")</p></div>
                    }
                </section>
        }
        else
        {
            <ManagementWorkspace @key="(role, tab)" Role="@role" Tab="@tab" />
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? RequestedTab { get; set; }
    private string role = "", tab = "", username = "";
    private bool allowed, loading, requested, hasEmployeeData, needsLogin;
    private string? error;
    private AccessibleBranch? branch;
    private OrderMenu? menu;
    private List<OrderSummary> orders = [];
    private WorkspaceLink? section;
    private string title => IsOverview ? role == "EMPLOYEE" ? "Ca làm của bạn" : "Tổng quan hôm nay" : section?.Label ?? "BranchFlow";
    private string subtitle => IsOverview ? role == "EMPLOYEE" ? $"Xin chào, {username}." : "Theo dõi hoạt động cửa hàng." : tab switch
    {
        "stock" or "inventory" => "Theo dõi nguyên liệu và ngưỡng cảnh báo.",
        "stocktake" => "Đối chiếu tồn kho cuối ca.", "payroll" => "Theo dõi kỳ lương và giờ làm.",
        "orders" => "Tra cứu đơn hàng trong phạm vi được cấp.", _ => "Quản lý theo phạm vi được phân công."
    };
    private bool IsOverview => tab is "home" or "overview";
    private static DateOnly Today => DateOnly.FromDateTime(DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).DateTime);
    private static string Money(decimal value) => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + "đ";
    protected override async Task OnParametersSetAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        role = WorkspaceNavigation.Role(user); username = user.Identity?.Name ?? "";
        var area = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        allowed = area switch { "employee" => role == "EMPLOYEE", "owner" => role == "OWNER", "admin" => role is "SYSTEM_ADMIN" or "BRANCH_ADMIN", _ => false };
        tab = string.IsNullOrEmpty(RequestedTab) ? role == "EMPLOYEE" ? "home" : "overview" : RequestedTab;
        section = WorkspaceNavigation.Links(role).FirstOrDefault(link => link.Key == tab);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (allowed && IsOverview && role == "EMPLOYEE" && !requested) { requested = true; await LoadEmployeeAsync(); }
    }
    private async Task LoadEmployeeAsync()
    {
        if (loading) return;
        loading = true; error = null; needsLogin = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            var branches = await Api.BranchesAsync();
            branch = branches.Count == 1 ? branches[0] : null;
            menu = branch is null ? null : await Api.MenuAsync(branch.Id);
            orders = await Api.MineAsync("", Today);
            hasEmployeeData = true;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or OperationCanceledException or InvalidOperationException)
        {
            error = ex is ApiException api ? api.Message : "Chưa tải được dữ liệu. Vui lòng thử lại.";
            needsLogin = ex is ApiException { StatusCode: System.Net.HttpStatusCode.Unauthorized };
            hasEmployeeData = false;
        }
        finally { loading = false; await InvokeAsync(StateHasChanged); }
    }
}

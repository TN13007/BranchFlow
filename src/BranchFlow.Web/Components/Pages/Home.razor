@page "/"
@attribute [Authorize]
@layout EmployeeLayout
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>BranchFlow</PageTitle>
<div class="page-content"><p role="status">Đang mở không gian làm việc…</p></div>
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        Navigation.NavigateTo(BranchFlow.Web.Models.Appearance.WorkspaceNavigation.Home(
            BranchFlow.Web.Models.Appearance.WorkspaceNavigation.Role(user)), replace: true);
    }
}

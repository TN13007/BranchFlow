@page "/forgot-password"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
<PageTitle>Quên mật khẩu | BranchFlow</PageTitle>
<section class="password-card business-panel" aria-labelledby="forgot-title">
    <h1 id="forgot-title">Quên mật khẩu</h1>
    <p>Gửi yêu cầu hỗ trợ, sau đó liên hệ Admin Tổng bằng kênh liên lạc đã biết để xác minh danh tính. Mật khẩu không tự đổi khi gửi yêu cầu.</p>
    @if (Sent)
    { <p class="alert alert-success" role="status">@BranchFlow.Application.Services.PasswordService.RequestAcknowledgement</p> }
    else
    {
        @if (Error is not null) { <p class="alert alert-danger" role="alert">@(Error == "rate" ? "Vui lòng chờ một phút trước khi thử lại." : "Chưa gửi được yêu cầu. Vui lòng thử lại sau.")</p> }
        <form action="/auth/forgot-password" method="post" data-enhance="false">
            <AntiforgeryToken />
            <label for="recovery-username">Tên đăng nhập</label>
            <input id="recovery-username" class="form-control" name="username" autocomplete="username" maxlength="100" required />
            <button class="btn btn-brand" type="submit">Gửi yêu cầu hỗ trợ</button>
        </form>
    }
    <a href="/login">Quay lại đăng nhập</a>
</section>
@code {
    [SupplyParameterFromQuery(Name = "sent")] public bool Sent { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}

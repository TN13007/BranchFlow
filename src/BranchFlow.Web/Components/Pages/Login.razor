@page "/login"
@layout AuthLayout
@using BranchFlow.Web.Models.Auth
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment
@implements IAsyncDisposable

<PageTitle>Đăng nhập | BranchFlow</PageTitle>

<div class="login-container @(errorMessage is not null ? "is-error-state" : "")">
    <section class="login-intro" aria-labelledby="intro-title">
        <span class="eyebrow">XƯỞNG QUÀ NGÔI LÀNG MÙA ĐÔNG</span>
        <h2 id="intro-title">Mỗi cửa hàng. <br />Một nhịp kết nối ấm áp.</h2>
        <p class="intro-description">
            Đăng nhập trước giờ lên đèn để mở quầy pha chế, tạo đơn chuẩn giá máy chủ và đồng bộ nhịp vận hành tại chi nhánh của bạn.
        </p>

        <div class="intro-highlights" aria-hidden="true">
            <span class="highlight-pill">✓ Quầy gọi món nhanh</span>
            <span class="highlight-pill">✓ Snapshot đơn chính xác</span>
            <span class="highlight-pill">✓ Phân quyền theo ca</span>
        </div>
    </section>

    <section class="login-card" aria-labelledby="login-title">
        <div class="login-card-header">
            <span class="card-season-tag">CA LÀM VIỆC MÙA ĐÔNG</span>
            <h1 id="login-title">Đăng nhập</h1>
            <p class="login-description" id="login-description">Sử dụng tài khoản được cấp để mở không gian làm việc.</p>
        </div>

        @if (noticeMessage is not null)
        {
            <div class="alert login-notice" role="status">
                <strong>Thông báo phiên:</strong> @noticeMessage
            </div>
        }

        <EditForm Model="form" OnValidSubmit="HandleValidSubmitAsync" OnInvalidSubmit="HandleInvalidSubmit"
                  id="branchflow-login" action="/auth/login" method="post" data-enhance="false"
                  FormName="login" aria-describedby="login-description" novalidate>
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="username">Tên đăng nhập <span class="required-mark" aria-hidden="true">*</span></label>
                <InputText id="username" name="username" class="form-control" @bind-Value="form.Username" disabled="@(!ready)"
                           autocomplete="username" autocapitalize="none" spellcheck="false"
                           aria-required="true" aria-describedby="username-hint username-error" />
                <small id="username-hint" class="field-hint">Nhập mã nhân viên hoặc tài khoản được phân quyền.</small>
                <div id="username-error" class="field-error" aria-live="polite">
                    <ValidationMessage For="() => form.Username" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label" for="password">Mật khẩu <span class="required-mark" aria-hidden="true">*</span></label>
                <div class="password-control">
                    <InputText id="password" name="password" class="form-control" @bind-Value="form.Password" disabled="@(!ready)"
                               type="@(showPassword ? "text" : "password")" autocomplete="current-password"
                               aria-required="true" aria-describedby="password-error" />
                    <button class="password-toggle" type="button" @onclick="TogglePassword"
                            aria-controls="password" aria-pressed="@(showPassword ? "true" : "false")"
                            aria-label="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="3" />
                            @if (showPassword)
                            {
                                <path d="m3 3 18 18" />
                            }
                        </svg>
                    </button>
                </div>
                <div id="password-error" class="field-error" aria-live="polite">
                    <ValidationMessage For="() => form.Password" />
                </div>
            </div>

            @if (errorMessage is not null)
            {
                <div class="alert login-alert" role="alert">
                    <strong>Chưa thể đăng nhập:</strong> @errorMessage
                </div>
            }

            <button class="btn login-submit w-100" type="submit" disabled="@(isSubmitting || !ready)" aria-busy="@(isSubmitting || !ready ? "true" : "false")">
                @(!ready ? "Đang kết nối…" : isSubmitting ? "Đang đăng nhập…" : "Đăng nhập vào ca làm")
            </button>
        </EditForm>

        <div class="support-box">
            <p class="support-note">
                Cần hỗ trợ cấp lại mật khẩu hoặc kiểm tra phân công?
                <strong>Vui lòng liên hệ quản lý chi nhánh hoặc quản trị viên của bạn.</strong>
            </p>
            @if (Environment.IsDevelopment())
            {
                <div class="dev-preview-links">
                    <span class="dev-preview-title">Xem thử giao diện tĩnh (Dữ liệu mẫu):</span>
                    <div class="dev-preview-actions">
                        <a href="/preview/orders">Quầy gọi món</a>
                        <a href="/preview/owner">Chủ sở hữu</a>
                        <a href="/preview/admin">Quản trị</a>
                        <a href="/preview/employee">Nhân viên</a>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private readonly LoginFormModel form = new();
    private bool showPassword;
    private string? errorMessage;
    private string? noticeMessage;
    private bool isSubmitting;
    private bool ready;
    private IJSObjectReference? module;
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "notice")] public string? Notice { get; set; }

    protected override void OnParametersSet()
    {
        errorMessage = Error switch
        {
            "credentials" => "Tên đăng nhập hoặc mật khẩu không đúng, hoặc tài khoản không khả dụng.",
            "invalid" => "Vui lòng nhập tên đăng nhập và mật khẩu hợp lệ.",
            "rate" => "Bạn đã thử quá nhiều lần. Vui lòng chờ một phút rồi thử lại.",
            "service" => "Không kết nối được dịch vụ đăng nhập. Vui lòng thử lại sau.",
            "unavailable" => "Dịch vụ đăng nhập tạm thời chưa sẵn sàng. Vui lòng thử lại sau; bạn không cần đổi mật khẩu.",
            _ => null
        };
        noticeMessage = Notice switch
        {
            "logout" => "Bạn đã đăng xuất.",
            "local-logout" => "Đã đăng xuất khỏi Web. Chưa xác nhận thu hồi phiên tại dịch vụ; vui lòng liên hệ quản lý nếu cần.",
            "session" => "Vui lòng đăng nhập để tiếp tục.",
            _ => null
        };
    }

    // Chỉ nhận nhập liệu sau khi circuit tương tác sẵn sàng, tránh mất giá trị lúc hydrate.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { ready = true; StateHasChanged(); }
    }

    private void TogglePassword() => showPassword = !showPassword;

    private void HandleInvalidSubmit(EditContext _) => errorMessage = null;

    private async Task HandleValidSubmitAsync()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        form.Username = form.Username.Trim();
        errorMessage = null;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/auth-form.js");
            await module.InvokeVoidAsync("submitLogin");
        }
        catch (JSException)
        {
            isSubmitting = false;
            errorMessage = "Không gửi được form. Vui lòng tải lại trang và thử lại.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        form.Password = string.Empty;
        if (module is not null)
            try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}

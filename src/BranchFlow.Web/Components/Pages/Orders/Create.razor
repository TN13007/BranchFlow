@page "/orders/create"
@attribute [Authorize(Roles = "EMPLOYEE")]
@layout EmployeeLayout
@inject OrderApiClient Api
@inject CartState Cart
@inject NavigationManager Navigation

<PageTitle>Gọi món | BranchFlow</PageTitle>
@if (loading)
{
    <header class="page-heading">
        <div>
            <p class="eyebrow">QUẦY PHA CHẾ · CA LÀM VIỆC</p>
            <h1>Gọi món</h1>
            <p>Đang đồng bộ danh mục đồ uống và bảng giá tại chi nhánh của bạn.</p>
        </div>
    </header>
    <div class="page-content">
        <div class="surface-card d-flex align-items-center gap-3" role="status">
            <span class="spinner-border spinner-border-sm text-success" aria-hidden="true"></span>
            <strong>Đang tải menu cửa hàng…</strong>
        </div>
    </div>
}
else
{
    @if (branches.Count > 1)
    {
        <div class="branch-picker">
            <label for="branch-picker" class="fw-bold">Chi nhánh được phép truy cập:</label>
            <select id="branch-picker" class="form-select" value="@branchId" @onchange="ChangeBranchAsync" disabled="@(submitting || Cart.OutcomeUnknown)">
                <option value="0">Chọn chi nhánh</option>
                @foreach (var b in branches)
                {
                    <option value="@b.Id">@b.Code · @b.Name</option>
                }
            </select>
            @if (Cart.Lines.Count > 0)
            {
                <label class="d-inline-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input mt-0" @bind="allowDiscard" />
                    <span>Tôi đồng ý bỏ giỏ hiện tại khi đổi chi nhánh.</span>
                </label>
            }
        </div>
    }
    @if (menu is not null)
    {
        <OrderWorkspace Menu="menu" Cart="Cart" Busy="@(submitting || reloading)" CanOrder="canOrder" Error="@error" NeedsLogin="needsLogin" Unavailable="unavailable" OnReload="ReloadMenuAsync" OnConfirm="ConfirmAsync" />
    }
    else
    {
        <header class="page-heading">
            <div>
                <p class="eyebrow">QUẦY PHA CHẾ · TRẠNG THÁI TRUY CẬP</p>
                <h1>Gọi món</h1>
                <p>Cần phân công chi nhánh hợp lệ và kết nối dịch vụ để mở menu bán hàng.</p>
            </div>
        </header>
        <div class="page-content">
            <ApiError Message="@error" NeedsLogin="needsLogin" Unavailable="unavailable" OnRetry="LoadAsync" Busy="loading" />
            @if (error is null && branches.Count == 0)
            {
                <div class="empty-state" role="status">
                    <img class="empty-state-figure decor-non-interactive" src="/images/christmas/characters/gingerbread-cup-buddy.jpg" alt="" />
                    <strong>Bạn chưa được phân công chi nhánh hiệu lực</strong>
                    <p class="mb-0 mt-1">Vui lòng liên hệ quản lý chi nhánh hoặc quản trị viên để cập nhật lịch phân công.</p>
                </div>
            }
        </div>
    }
}

@code {
    private List<AccessibleBranch> branches = [];
    private OrderMenu? menu;
    private int branchId;
    private bool loading = true;
    private bool submitting;
    private bool reloading;
    private bool canOrder = true;
    private bool allowDiscard;
    private bool needsLogin;
    private bool unavailable;
    private string? error;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await LoadAsync(); StateHasChanged(); }
    }
    private async Task LoadAsync()
    {
        loading = true; error = null; needsLogin = false; unavailable = false;
        try
        {
            var me = await Api.MeAsync();
            if (me.Role != "EMPLOYEE") { Navigation.NavigateTo("/account", true); return; }
            branches = await Api.BranchesAsync();
            branchId = Cart.BranchId.HasValue && branches.Any(b => b.Id == Cart.BranchId) ? Cart.BranchId.Value : branches.Count == 1 ? branches[0].Id : 0;
            if (branchId > 0) await LoadMenuAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or OperationCanceledException or InvalidOperationException) { SetError(ex); }
        finally { loading = false; }
    }
    private async Task LoadMenuAsync()
    {
        var result = await Api.MenuAsync(branchId);
        if (result.Branch.Id != branchId) throw new InvalidOperationException("Menu không khớp chi nhánh đã chọn.");
        Cart.SetBranch(branchId);
        menu = result;
        canOrder = true;
        Cart.Revalidate(result);
    }
    private async Task ChangeBranchAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var next) || !branches.Any(b => b.Id == next)) return;
        if (Cart.Lines.Count > 0 && !allowDiscard) { error = "Vui lòng xác nhận bỏ giỏ trước khi đổi chi nhánh."; return; }
        if (Cart.OutcomeUnknown) return;
        branchId = next; allowDiscard = false; menu = null;
        await ReloadMenuAsync();
    }
    private async Task ReloadMenuAsync()
    {
        if (reloading) return;
        reloading = true; error = null; needsLogin = false; unavailable = false;
        try { await LoadMenuAsync(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or OperationCanceledException or InvalidOperationException) { SetError(ex); }
        finally { reloading = false; }
    }
    private async Task ConfirmAsync()
    {
        if (submitting || reloading || !canOrder || menu is null || Cart.OutcomeUnknown) return;
        submitting = true; error = null; needsLogin = false; unavailable = false;
        var sent = false;
        try
        {
            var oldTotal = Cart.PreviewTotal;
            await LoadMenuAsync();
            var request = Cart.ToRequest(menu);
            if (Cart.PreviewTotal != oldTotal) { error = "Giá menu vừa thay đổi. Vui lòng kiểm tra tổng tạm tính mới rồi xác nhận lại."; return; }
            sent = true;
            var result = await Api.CreateAsync(request);
            if (result.Id <= 0 || string.IsNullOrWhiteSpace(result.Code) || result.BranchId != branchId)
                throw new ApiException(System.Net.HttpStatusCode.BadGateway, "Phản hồi tạo đơn không hợp lệ. Hãy kiểm tra danh sách đơn.");
            Cart.Complete(result);
            Navigation.NavigateTo($"/orders/{result.Id}");
        }
        catch (ApiException ex)
        {
            if (sent && (int)ex.StatusCode >= 500) Cart.MarkUnknown();
            SetError(ex);
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            if (sent) Cart.MarkUnknown();
            SetError(ex);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OverflowException) { SetError(ex); }
        finally { submitting = false; }
    }
    private void SetError(Exception ex)
    {
        unavailable = ex is HttpRequestException or OperationCanceledException
            or ApiException { StatusCode: System.Net.HttpStatusCode.ServiceUnavailable or System.Net.HttpStatusCode.BadGateway or System.Net.HttpStatusCode.GatewayTimeout };
        needsLogin = ex is ApiException { StatusCode: System.Net.HttpStatusCode.Unauthorized };
        if (ex is ApiException { StatusCode: System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden }) canOrder = false;
        error = ex is ApiException or InvalidOperationException ? ex.Message : "Không kết nối được dịch vụ. Giỏ hàng của bạn vẫn được giữ.";
    }
}

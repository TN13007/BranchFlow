@page "/orders/{Id:int}"
@attribute [Authorize(Roles = "EMPLOYEE")]
@layout EmployeeLayout
@inject OrderApiClient Api
@inject CartState Cart

<PageTitle>Chi tiết đơn | BranchFlow</PageTitle>
<header class="page-heading">
    <div>
        <p class="eyebrow">GÓC ĐÓNG GÓI · SNAPSHOT ĐƠN HÀNG</p>
        <h1>Chi tiết đơn</h1>
        <p>Thông tin món, topping, ghi chú và giá được lưu cố định tại thời điểm xác nhận đơn.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/orders/mine" class="btn btn-outline-secondary" style="min-height:44px;display:inline-flex;align-items:center;">← Đơn của tôi</a>
        <a href="/orders/create" class="btn btn-brand">+ Tạo đơn mới</a>
    </div>
</header>
<div class="page-content">
    @if (Cart.LastCreated is { } result && result.Id == Id)
    {
        <div class="alert alert-success position-relative" role="status" style="border:1.5px solid #8CC4A9; background:#E6F4EE; color:#0D4A30; border-radius:12px; padding:18px 22px;">
            <img class="cart-summary-ribbon decor-non-interactive" src="/images/christmas/decorations/bell-bauble-sprig.svg" alt="" aria-hidden="true" />
            <strong>✓ Đã xác nhận tạo đơn thành công: @result.Code</strong><br />
            <span>Tổng tiền máy chủ xác nhận: <strong>@Display.Money(result.TotalAmount)</strong> · Ngày kinh doanh: <strong>@result.BusinessDate.ToString("dd/MM/yyyy")</strong></span>
        </div>
    }

    <ApiError Message="@error" NeedsLogin="needsLogin" Unavailable="unavailable" OnRetry="LoadAsync" Busy="loading" />

    @if (loading)
    {
        <div class="surface-card d-flex align-items-center gap-3" role="status">
            <span class="spinner-border spinner-border-sm text-success" aria-hidden="true"></span>
            <strong>Đang tải chi tiết đơn…</strong>
        </div>
    }
    else if (order is not null)
    {
        <section class="detail-summary" aria-label="Tóm tắt hóa đơn">
            <img class="cart-summary-ribbon decor-non-interactive" src="/images/christmas/decorations/candy-cane-swirl-set.svg" alt="" aria-hidden="true" />
            <div>
                <p class="eyebrow">@order.BranchCode · @order.BranchName</p>
                <h2>@order.Code</h2>
                <p class="mb-0">Thời điểm tạo: @Display.VietnamTime(order.CreatedAt) (Giờ VN)</p>
            </div>
            <div class="text-md-end">
                <StatusBadge Status="@order.Status" />
                <h2 class="mt-2 mb-1">@Display.Money(order.TotalAmount)</h2>
                <small>Ngày kinh doanh: @order.BusinessDate.ToString("dd/MM/yyyy")</small>
            </div>
        </section>

        <div class="section-heading pt-0 border-top-0">
            <h2>Danh sách đồ uống trong đơn</h2>
            <span>@order.Items.Sum(i => i.Quantity) ly (@order.Items.Count dòng cấu hình)</span>
        </div>

        @foreach (var item in order.Items)
        {
            <article class="detail-item">
                <div>
                    <h3>@item.ProductName</h3>
                    <p class="fw-semibold">Size @item.SizeName · @item.Quantity ly × @Display.Money(item.UnitPrice)</p>
                    @foreach (var topping in item.Toppings)
                    {
                        <p class="text-secondary">Topping: @topping.Name × @topping.Quantity phần/ly · @Display.Money(topping.UnitPrice)/phần</p>
                    }
                    @foreach (var note in item.Notes)
                    {
                        <span class="note-badge">@note.Name</span>
                    }
                </div>
                <strong class="fs-6">@Display.Money(item.SubtotalAmount)</strong>
            </article>
        }

        @if (order.ReportReason is not null)
        {
            <div class="alert alert-warning mt-3" role="status">
                <strong>Ghi nhận báo cáo đơn:</strong> @order.ReportReason
                @if (order.ReportedAt.HasValue)
                {
                    <small class="ms-1">· @Display.VietnamTime(order.ReportedAt.Value)</small>
                }
            </div>
        }

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a href="/orders/create" class="btn btn-brand">Tạo đơn mới</a>
            <a href="/orders/mine" class="btn btn-outline-secondary" style="min-height:44px;display:inline-flex;align-items:center;">Quay lại danh sách đơn</a>
        </div>
    }

</div>

@code {
    [Parameter] public int Id { get; set; }
    private int loadedId;
    private bool loading = true;
    private OrderDetail? order;
    private string? error;
    private bool needsLogin;
    private bool unavailable;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || loadedId != Id) { loadedId = Id; await LoadAsync(); StateHasChanged(); }
    }
    private async Task LoadAsync()
    {
        loading = true; error = null; order = null; needsLogin = false; unavailable = false;
        try { order = await Api.DetailAsync(Id); }
        catch (ApiException ex) { unavailable = ex.StatusCode is System.Net.HttpStatusCode.ServiceUnavailable or System.Net.HttpStatusCode.BadGateway or System.Net.HttpStatusCode.GatewayTimeout; error = ex.Message; needsLogin = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { unavailable = true; error = "Không tải được chi tiết. Nếu vừa tạo đơn thành công, hãy kiểm tra danh sách trước khi tạo lại."; }
        finally { loading = false; }
    }
}

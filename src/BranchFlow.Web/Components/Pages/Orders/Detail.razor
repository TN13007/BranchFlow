@page "/orders/{Id:int}"
@attribute [Authorize(Roles = "EMPLOYEE")]
@layout EmployeeLayout
@inject OrderApiClient Api
@inject CartState Cart

<PageTitle>Chi tiết đơn | BranchFlow</PageTitle>
<header class="page-heading business-page-heading staff-page-heading">
    <div>
        <h1>Chi tiết đơn</h1>
        <p>Xem món, số tiền và trạng thái của đơn.</p>
    </div>
    <div class="staff-page-actions">
        <a href="/orders/mine" class="btn btn-outline-secondary">← Đơn của tôi</a>
        <a href="/orders/create" class="btn btn-brand">+ Tạo đơn mới</a>
    </div>
</header>
<div class="page-content staff-content">
    @if (Cart.LastCreated is { } result && result.Id == Id)
    {
        <div class="alert alert-success staff-order-success" role="status">
            <strong>Đã tạo đơn @result.Code</strong>
        </div>
    }

    <ApiError Message="@error" NeedsLogin="needsLogin" Unavailable="unavailable" OnRetry="LoadAsync" Busy="loading" />

    @if (loading)
    {
        <div class="surface-card d-flex align-items-center gap-3" role="status">
            <span class="spinner-border spinner-border-sm text-success" aria-hidden="true"></span>
            <strong>Đang tải chi tiết đơn…</strong>
        </div>
    }
    else if (order is not null)
    {
        <section class="detail-summary staff-detail-summary" aria-label="Tóm tắt hóa đơn">
            <div>
                <p class="eyebrow">@order.BranchCode · @order.BranchName</p>
                <h2>@order.Code</h2>
                <p class="mb-0">Thời điểm tạo: @Display.VietnamTime(order.CreatedAt) (Giờ VN)</p>
            </div>
            <div class="text-md-end">
                <StatusBadge Status="@order.Status" />
                <h2 class="mt-2 mb-1">@Display.Money(order.TotalAmount)</h2>
                <small>Ngày kinh doanh: @order.BusinessDate.ToString("dd/MM/yyyy")</small>
            </div>
        </section>

        @if (order.Status == "COMPLETED" || !string.IsNullOrWhiteSpace(order.ReportReason))
        {
        <section class="staff-order-report" aria-labelledby="order-report-title">
            <h2 id="order-report-title">Báo đơn sai</h2>
            @if (!string.IsNullOrWhiteSpace(order.ReportReason))
            {
                <p class="staff-report-status" role="status">
                    @(order.HasPendingReport ? "Đã gửi · Chờ Admin xử lý" : order.Status == "NEEDS_REVIEW" ? "Cần xem lại" : "Báo cáo đã được xử lý")
                </p>
                <p class="staff-report-reason">@order.ReportReason</p>
                @if (order.ReportedAt is { } reportedAt) { <small>Ngày gửi @Display.VietnamTime(reportedAt) (giờ VN)</small> }
            }
            <ApiError Message="@reportError" NeedsLogin="@reportNeedsLogin" />
            @if (reportReloadRequired && !reportNeedsLogin)
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ReloadAfterReportAsync" disabled="@reportSending">Kiểm tra lại trạng thái đơn</button>
            }
            @if (order.Status == "COMPLETED" && !order.HasPendingReport && !reportReloadRequired)
            {
                @if (reportOpen)
                {
                    <label class="management-field">Lý do báo đơn sai
                        <textarea class="form-control" rows="3" maxlength="500" placeholder="Ví dụ: khách gọi 2 ly nhưng đơn ghi 1 ly"
                                  @bind="reportReason" @bind:event="oninput" disabled="@reportSending"></textarea>
                    </label>
                    <div class="management-actions mt-2">
                        <button class="btn btn-brand" type="button" disabled="@(reportSending || string.IsNullOrWhiteSpace(reportReason))" @onclick="SendReportAsync">@(reportSending ? "Đang gửi…" : "Gửi báo cáo")</button>
                        <button class="btn btn-outline-secondary" type="button" disabled="@reportSending" @onclick="() => reportOpen = false">Đóng</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-outline-secondary mt-2" type="button" @onclick="() => reportOpen = true">@(order.ReportedAt.HasValue ? "Báo sai lần nữa" : "Báo đơn sai")</button>
                }
            }
        </section>
        }

        <div class="section-heading pt-0 border-top-0">
            <h2>Danh sách đồ uống trong đơn</h2>
            <span>@order.Items.Sum(i => i.Quantity) ly (@order.Items.Count dòng cấu hình)</span>
        </div>

        @foreach (var item in order.Items)
        {
            <article class="detail-item">
                <div>
                    <h3>@item.ProductName</h3>
                    <p class="fw-semibold">Size @item.SizeName · @item.Quantity ly × @Display.Money(item.UnitPrice)</p>
                    @foreach (var topping in item.Toppings)
                    {
                        <p class="text-secondary">Topping: @topping.Name × @topping.Quantity phần/ly · @Display.Money(topping.UnitPrice)/phần</p>
                    }
                    @foreach (var note in item.Notes)
                    {
                        <span class="note-badge">@note.Name</span>
                    }
                </div>
                <strong class="fs-6">@Display.Money(item.SubtotalAmount)</strong>
            </article>
        }

    }

</div>

@code {
    [Parameter] public int Id { get; set; }
    private int loadedId;
    private bool loading = true;
    private OrderDetail? order;
    private string? error;
    private bool needsLogin;
    private bool unavailable;
    private bool reportOpen, reportSending, reportReloadRequired, reportNeedsLogin;
    private string reportReason = "";
    private string? reportError;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || loadedId != Id)
        {
            loadedId = Id;
            reportOpen = reportReloadRequired = reportNeedsLogin = false;
            reportReason = ""; reportError = null;
            await LoadAsync();
            StateHasChanged();
        }
    }
    private async Task SendReportAsync()
    {
        if (reportSending || reportReloadRequired || order is not { Status: "COMPLETED", HasPendingReport: false }
            || string.IsNullOrWhiteSpace(reportReason)) return;
        reportSending = true;
        reportError = null;
        try
        {
            await Api.ReportAsync(Id, reportReason);
            reportReason = "";
            reportOpen = false;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            reportError = ex.Message;
            reportNeedsLogin = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            reportReloadRequired = reportNeedsLogin || ex.StatusCode == System.Net.HttpStatusCode.Conflict || (int)ex.StatusCode >= 500;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            reportReloadRequired = true;
            reportError = "Chưa xác định kết quả gửi báo cáo. Kiểm tra trạng thái đơn trước khi gửi lại.";
        }
        finally { reportSending = false; }
    }
    private async Task ReloadAfterReportAsync()
    {
        await LoadAsync();
        if (order is not null) { reportReloadRequired = false; reportError = null; }
    }
    private async Task LoadAsync()
    {
        loading = true; error = null; order = null; needsLogin = false; unavailable = false;
        try { order = await Api.DetailAsync(Id); }
        catch (ApiException ex) { unavailable = ex.StatusCode is System.Net.HttpStatusCode.ServiceUnavailable or System.Net.HttpStatusCode.BadGateway or System.Net.HttpStatusCode.GatewayTimeout; error = ex.Message; needsLogin = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { unavailable = true; error = "Không tải được chi tiết. Nếu vừa tạo đơn thành công, hãy kiểm tra danh sách trước khi tạo lại."; }
        finally { loading = false; }
    }
}

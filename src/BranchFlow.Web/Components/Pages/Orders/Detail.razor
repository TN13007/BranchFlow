@page "/orders/{Id:int}"
@attribute [Authorize(Roles = "EMPLOYEE")]
@layout EmployeeLayout
@inject OrderApiClient Api
@inject CartState Cart

<PageTitle>Chi tiết đơn | BranchFlow</PageTitle>
<header class="page-heading"><div><h1>Chi tiết đơn</h1><p>Thông tin món và giá được lưu khi tạo đơn.</p></div><a href="/orders/mine" class="btn btn-outline-secondary">← Đơn của tôi</a></header>
<div class="page-content">
    @if (Cart.LastCreated is { } result && result.Id == Id)
    {
        <div class="alert alert-success" role="status"><strong>Đã tạo đơn @result.Code</strong><br />Tổng tiền: @Display.Money(result.TotalAmount) · Ngày kinh doanh: @result.BusinessDate.ToString("dd/MM/yyyy")</div>
    }
    <ApiError Message="@error" NeedsLogin="needsLogin" />
    @if (loading) { <p role="status">Đang tải chi tiết đơn…</p> }
    else if (order is not null)
    {
        <section class="detail-summary"><div><p class="eyebrow">@order.BranchCode · @order.BranchName</p><h2>@order.Code</h2><p>@Display.VietnamTime(order.CreatedAt)</p></div>
            <div><StatusBadge Status="@order.Status" /><h2 class="mt-3">@Display.Money(order.TotalAmount)</h2><small>Ngày kinh doanh: @order.BusinessDate.ToString("dd/MM/yyyy")</small></div></section>
        @foreach (var item in order.Items)
        {
            <article class="detail-item"><div><h3>@item.ProductName</h3><p>Size @item.SizeName · @item.Quantity ly × @Display.Money(item.UnitPrice)</p>
                @foreach (var topping in item.Toppings) { <p class="text-secondary">@topping.Name × @topping.Quantity phần/ly · @Display.Money(topping.UnitPrice)/phần</p> }
                @foreach (var note in item.Notes) { <span class="note-badge">@note.Name</span> }
            </div><strong>@Display.Money(item.SubtotalAmount)</strong></article>
        }
        @if (order.ReportReason is not null) { <div class="alert alert-warning mt-3">@order.ReportReason @if (order.ReportedAt.HasValue) { <small>· @Display.VietnamTime(order.ReportedAt.Value)</small> }</div> }
        <a href="/orders/create" class="btn btn-brand mt-4">Tạo đơn mới</a>
    }
    @if (error is not null) { <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@loading">Tải lại chi tiết</button> }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private int loadedId;
    private bool loading = true;
    private OrderDetail? order;
    private string? error;
    private bool needsLogin;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || loadedId != Id) { loadedId = Id; await LoadAsync(); StateHasChanged(); }
    }
    private async Task LoadAsync()
    {
        loading = true; error = null; order = null; needsLogin = false;
        try { order = await Api.DetailAsync(Id); }
        catch (ApiException ex) { error = ex.Message; needsLogin = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { error = "Không tải được chi tiết. Nếu vừa tạo đơn thành công, hãy kiểm tra danh sách trước khi tạo lại."; }
        finally { loading = false; }
    }
}

@inject AuthenticationStateProvider Authentication
@inject BranchFlow.Web.Services.Auth.WebSessionStore Sessions
@inject NavigationManager Navigation
@if (!restricted) { @ChildContent }
@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = null!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool restricted;
    protected override async Task OnParametersSetAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        var session = Sessions.Find(state.User.FindFirst(BranchFlow.Web.Services.Auth.WebSessionStore.SessionClaim)?.Value);
        restricted = session?.User.MustChangePassword == true && RouteData.PageType != typeof(Pages.ChangePassword);
        if (restricted) Navigation.NavigateTo("/change-password", forceLoad: true, replace: true);
    }
}
